    @media (max-width: 460px) {
      .bandeau-inner { justify-content: space-between; text-align: left; flex-wrap: wrap; }
      .nav-toggle { display: flex; }
      .topnav {
        position: absolute;
        top: 100%;
        left: 1rem;
        right: 1rem;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 10px;
        box-shadow: 0 12px 32px var(--shadow);
        padding: .4rem;
        opacity: 0;
        transform: translateY(-6px);
        pointer-events: none;
        transition: opacity .18s ease, transform .18s ease;
        z-index: 25;
      }
      .topnav.open { opacity: 1; transform: translateY(0); pointer-events: auto; }
      .topnav a { padding: .65rem .6rem; border-radius: 6px; }
      .topnav a:hover { background: rgba(139, 92, 246, .08); }
      .bandeau-right { flex-basis: 100%; justify-content: center; }
      .footer-links { position: static; align-self: center; margin: 2rem 0 1.5rem; }
      .copyright { position: static; transform: none; text-align: center; margin: 0 0 1.5rem; }
      .status-nav { position: static; }
      .dropdown { left: 50%; right: auto; width: min(340px, calc(100vw - 2rem)); transform: translateX(-50%) translateY(-6px); }
      .dropdown.open, .status-nav:hover .dropdown { transform: translateX(-50%) translateY(0); }
      .lang-nav { position: static; }
      .lang-dropdown { left: 50%; right: auto; transform: translateX(-50%) translateY(-6px); }
      .lang-dropdown.open { transform: translateX(-50%) translateY(0); }
      .search-btn span { display: none; }
      .search-btn { padding: 0 .55rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: .001ms !important;
        transition-duration: .001ms !important;
      }
    }

{% from "partials/js_str.j2" import js_str %}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script>
{% include "partials/theme_toggle.js.j2" %}
  </script>
  <title>{{ i18n['title.api'] }}</title>
  <meta name="description" content="{{ meta_description }}" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="{{ og_url }}" />
  <meta property="og:title" content="{{ i18n['title.api'] }}" />
  <meta property="og:description" content="{{ meta_description }}" />
  <meta property="og:image" content="{{ brand_icon_src }}" />
  <meta property="og:locale" content="{{ og_locale }}" />
  <meta property="og:locale:alternate" content="{{ og_locale_alternate }}" />
  <link rel="canonical" href="{{ canonical_url }}" />
  <link rel="alternate" hreflang="en" href="{{ hreflang_en_href }}" />
  <link rel="alternate" hreflang="fr" href="{{ hreflang_fr_href }}" />
  <link rel="alternate" hreflang="x-default" href="{{ hreflang_x_default_href }}" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="{{ i18n['title.api'] }}" />
  <meta name="twitter:image" content="{{ brand_icon_src }}" />
  <link rel="icon" href="{{ brand_icon_src }}" type="image/png" />
  <link rel="apple-touch-icon" href="{{ brand_icon_src }}" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700;800&display=swap" rel="stylesheet" />

  <!-- Matomo -->
  <script>
    var _paq = window._paq = window._paq || [];
    _paq.push(['trackPageView']);
    _paq.push(['enableLinkTracking']);
    (function() {
      var u="//matomo.khaddict.com/";
      _paq.push(['setTrackerUrl', u+'matomo.php']);
      _paq.push(['setSiteId', '1']);
      var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
      g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
    })();
  </script>
  <!-- End Matomo -->

  <style>
{% include "partials/head_tokens.css.j2" %}
{% include "partials/status_widget.css.j2" %}
    /* api docs */
    .api-hero {
      flex: 1;
      display: flex;
      justify-content: center;
      padding: 3rem 1.5rem;
      animation: fade-up .45s ease both;
    }

    @keyframes fade-up {
      from { opacity: 0; transform: translateY(10px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .api-inner { max-width: 860px; width: 100%; }

    .api-group { margin-bottom: 2rem; }

    .api-group-title {
      font-size: .78rem;
      font-weight: 700;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: .8rem;
    }

    .api-endpoints {
      display: flex;
      flex-direction: column;
      gap: .8rem;
    }

    .api-endpoint {
      padding: 1.1rem 1.3rem;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: var(--surface);
      transition: border-color .15s ease;
    }

    .api-endpoint:hover { border-color: var(--accent); }

    .api-endpoint-head {
      display: flex;
      align-items: center;
      gap: .7rem;
      flex-wrap: wrap;
    }

    .api-method {
      font-family: 'JetBrains Mono', monospace;
      font-size: .68rem;
      font-weight: 700;
      color: #fff;
      padding: .2rem .55rem;
      border-radius: 999px;
      letter-spacing: .03em;
      flex-shrink: 0;
    }

    .api-method.post { background: var(--accent); }
    .api-method.get { background: var(--accent-2); }
    .api-method.delete { background: var(--down); }
    .api-method.put, .api-method.patch { background: var(--warn); }

    .api-path {
      font-family: 'JetBrains Mono', monospace;
      font-size: .85rem;
      font-weight: 600;
      word-break: break-all;
    }

    .api-summary {
      font-size: .8rem;
      color: var(--muted);
      margin-top: .5rem;
      line-height: 1.6;
    }

    .api-detail-title {
      font-size: .68rem;
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
      color: var(--muted);
      margin: .8rem 0 .35rem;
    }

    .api-fields {
      display: flex;
      flex-direction: column;
      gap: .3rem;
      font-family: 'JetBrains Mono', monospace;
      font-size: .76rem;
    }

    .api-field-name { color: var(--text); font-weight: 600; }
    .api-field-type { color: var(--accent-2); }
    .api-field-required { color: var(--down); font-size: .68rem; margin-left: .3rem; }

    .api-responses {
      display: flex;
      flex-wrap: wrap;
      gap: .4rem;
      font-family: 'JetBrains Mono', monospace;
      font-size: .72rem;
    }

    .api-response-code {
      padding: .15rem .5rem;
      border-radius: 999px;
      border: 1px solid var(--border);
      color: var(--muted);
    }

    .api-status {
      font-size: .8rem;
      color: var(--muted);
      padding: 2rem 0;
      text-align: center;
    }

    .api-status.error { color: var(--down); }

    .api-try {
      margin-top: .9rem;
      padding-top: .9rem;
      border-top: 1px solid var(--border);
    }

    .api-try-fields {
      display: flex;
      flex-direction: column;
      gap: .6rem;
      margin-bottom: .7rem;
    }

    .api-try-label {
      display: block;
      font-family: 'JetBrains Mono', monospace;
      font-size: .72rem;
      color: var(--muted);
      margin-bottom: .25rem;
    }

    .api-try-input {
      width: 100%;
      max-width: 360px;
      font-family: 'JetBrains Mono', monospace;
      font-size: .8rem;
      padding: .4rem .55rem;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--bg);
      color: var(--text);
    }

    .api-try-color { position: relative; }

    .api-try-color-btn {
      display: flex;
      align-items: center;
      gap: .5rem;
      max-width: 200px;
      height: 34px;
      padding: 0 .7rem;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--bg);
      color: var(--text);
      cursor: pointer;
      font-family: 'JetBrains Mono', monospace;
      font-size: .8rem;
      transition: border-color .15s ease;
    }

    .api-try-color-btn:hover { border-color: var(--accent); }
    .api-try-color-btn svg { width: 10px; height: 10px; margin-left: auto; flex-shrink: 0; color: var(--muted); }

    .api-try-color-swatch {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      flex-shrink: 0;
      border: 1px solid rgba(255, 255, 255, .25);
    }

    .api-try-color-dropdown {
      position: absolute;
      top: calc(100% + .4rem);
      left: 0;
      min-width: 160px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      box-shadow: 0 12px 32px var(--shadow);
      padding: .4rem;
      opacity: 0;
      transform: translateY(-6px);
      pointer-events: none;
      transition: opacity .18s ease, transform .18s ease;
      z-index: 10;
    }

    .api-try-color.open .api-try-color-dropdown {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .api-try-color-option {
      display: flex;
      align-items: center;
      gap: .55rem;
      width: 100%;
      text-align: left;
      padding: .4rem .55rem;
      border-radius: 6px;
      border: none;
      background: none;
      color: var(--muted);
      font-family: 'JetBrains Mono', monospace;
      font-size: .78rem;
      cursor: pointer;
      transition: background .15s ease, color .15s ease;
    }

    .api-try-color-option:hover { background: rgba(139, 92, 246, .08); color: var(--accent); }
    .api-try-color-option.active { color: var(--accent); font-weight: 600; }

    .api-try-btn {
      font-size: .76rem;
      font-weight: 600;
      padding: .45rem 1rem;
      border-radius: 999px;
      border: none;
      background: var(--accent);
      color: #1a1a22;
      cursor: pointer;
      transition: opacity .15s ease;
    }

    .api-try-btn:disabled { opacity: .6; cursor: default; }

    .api-try-file {
      display: flex;
      align-items: center;
      gap: .6rem;
      flex-wrap: wrap;
    }

    .api-try-file-input {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    .api-try-file-btn {
      font-family: 'JetBrains Mono', monospace;
      font-size: .76rem;
      font-weight: 600;
      padding: .4rem .85rem;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      cursor: pointer;
      transition: border-color .15s ease;
    }

    .api-try-file-btn:hover { border-color: var(--accent); }

    .api-try-file:has(.api-try-file-input:focus-visible) .api-try-file-btn {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    .api-try-file-name {
      font-family: 'JetBrains Mono', monospace;
      font-size: .76rem;
      color: var(--muted);
    }

    .api-try-response {
      display: none;
      margin-top: .7rem;
      padding: .7rem .85rem;
      border-radius: 8px;
      background: var(--bg);
      border: 1px solid var(--border);
      font-family: 'JetBrains Mono', monospace;
      font-size: .74rem;
      white-space: pre-wrap;
      word-break: break-all;
    }

    .api-try-response.ok, .api-try-response.err { display: block; }
    .api-try-response.ok { border-color: var(--accent-2); }
    .api-try-response.err { border-color: var(--down); color: var(--down); }
{% include "partials/responsive.css.j2" %}
  </style>
</head>

<body>
{% include "partials/header.html.j2" %}

  <main class="api-hero">
    <div class="api-inner">
      <div id="api-status" class="api-status" data-i18n="api.loading">{{ i18n['api.loading'] }}</div>
      <div id="api-groups"></div>
    </div>
  </main>

{% include "partials/footer.html.j2" %}

  <script>
    const I18N = {
{% for locale in ['en', 'fr'] %}
      {{ locale }}: {
{% for key, value in i18n_all[locale].items() %}
        '{{ key }}': {{ js_str(value) }},
{% endfor %}
      },
{% endfor %}
    };

    let currentLang = '{{ lang }}';

    function t(key) {
      return (I18N[currentLang] && I18N[currentLang][key]) || I18N.en[key] || key;
    }

    function applyLanguage() {
      document.documentElement.lang = currentLang;
      document.title = t('title.api');
      document.querySelectorAll('[data-i18n]').forEach((el) => {
        el.innerHTML = t(el.getAttribute('data-i18n'));
      });
      document.querySelectorAll('[data-i18n-aria]').forEach((el) => {
        el.setAttribute('aria-label', t(el.getAttribute('data-i18n-aria')));
      });
      document.getElementById('lang-current').textContent = currentLang.toUpperCase();
      document.querySelectorAll('.lang-option').forEach((el) => {
        el.classList.toggle('active', el.getAttribute('data-lang') === currentLang);
      });
    }

    applyLanguage();

    const langBtn = document.getElementById('lang-btn');
    const langDropdown = document.getElementById('lang-dropdown');

    langBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = langDropdown.classList.toggle('open');
      langBtn.setAttribute('aria-expanded', isOpen);
    });
    document.addEventListener('click', (e) => {
      if (!langDropdown.contains(e.target) && e.target !== langBtn) {
        langDropdown.classList.remove('open');
        langBtn.setAttribute('aria-expanded', 'false');
      }
    });
{% include "partials/status_widget.js.j2" %}

    document.getElementById('theme-toggle').addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      setThemeCookie(next);
    });

    (function () {
      const discordBtn = document.getElementById('discord-btn');
      const discordToast = document.getElementById('discord-toast');
      let toastTimer = null;

      discordBtn.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText('khaddict'); } catch { /* clipboard unavailable */ }
        discordBtn.classList.add('copied');
        discordToast.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          discordToast.classList.remove('show');
          discordBtn.classList.remove('copied');
        }, 900);
      });
    })();

    // fetches the live OpenAPI spec and renders it with the site's own
    // components instead of Swagger's stock widget
    (function () {
      const API_BASE_URL = '{{ api_base_url }}';
      const statusEl = document.getElementById('api-status');
      const groupsEl = document.getElementById('api-groups');
      const METHOD_ORDER = ['post', 'get', 'put', 'patch', 'delete'];
      const GROUP_ORDER = ['BUSY Bar', 'System'];

      // mirrors the swatches offered by the wall widget on the homepage
      const WALL_COLORS = [
        { name: 'White', hex: '#FFFFFF' },
        { name: 'Red', hex: '#FF0000' },
        { name: 'Orange', hex: '#FF8800' },
        { name: 'Yellow', hex: '#FFFF00' },
        { name: 'Green', hex: '#00FF00' },
        { name: 'Cyan', hex: '#00FFFF' },
        { name: 'Blue', hex: '#0066FF' },
        { name: 'Magenta', hex: '#FF00FF' },
      ];

      function resolveSchema(spec, schema) {
        if (!schema) return null;
        if (schema.$ref) {
          const name = schema.$ref.split('/').pop();
          return (spec.components && spec.components.schemas && spec.components.schemas[name]) || null;
        }
        return schema;
      }

      function schemaTypeLabel(prop) {
        if (!prop) return 'any';
        if (prop.type === 'array') return `${(prop.items && prop.items.type) || 'any'}[]`;
        return prop.type || 'any';
      }

      function renderRequestFields(spec, operation) {
        const body = operation.requestBody;
        if (!body || !body.content) return '';
        const media = body.content['application/json'] || body.content['multipart/form-data'];
        if (!media) return '';
        const schema = resolveSchema(spec, media.schema);
        if (!schema || !schema.properties) return '';
        const required = new Set(schema.required || []);
        const rows = Object.entries(schema.properties).map(([name, prop]) => `
          <div>
            <span class="api-field-name">${name}</span>
            <span class="api-field-type">${schemaTypeLabel(prop)}</span>
            ${required.has(name) ? `<span class="api-field-required">${t('api.required')}</span>` : ''}
          </div>
        `).join('');
        return `<div class="api-detail-title">${t('api.body')}</div><div class="api-fields">${rows}</div>`;
      }

      function renderParams(operation) {
        const params = operation.parameters;
        if (!params || !params.length) return '';
        const rows = params.map((p) => `
          <div>
            <span class="api-field-name">${p.name}</span>
            <span class="api-field-type">${schemaTypeLabel(p.schema)} · ${p.in}</span>
            ${p.required ? `<span class="api-field-required">${t('api.required')}</span>` : ''}
          </div>
        `).join('');
        return `<div class="api-detail-title">${t('api.params')}</div><div class="api-fields">${rows}</div>`;
      }

      function renderResponses(operation) {
        const responses = operation.responses;
        if (!responses) return '';
        const chips = Object.keys(responses).map((code) => `<span class="api-response-code">${code}</span>`).join('');
        return `<div class="api-detail-title">${t('api.responses')}</div><div class="api-responses">${chips}</div>`;
      }

      function fieldInputHtml(fieldId, name, prop, required) {
        if (name === 'color') {
          const selected = (prop && WALL_COLORS.find((c) => c.hex === prop.default)) || WALL_COLORS[0];
          const options = WALL_COLORS.map((c) => `
            <button type="button" class="api-try-color-option${c.hex === selected.hex ? ' active' : ''}" data-value="${c.hex}">
              <span class="api-try-color-swatch" style="background:${c.hex}"></span>
              <span class="api-try-color-option-label">${c.name}</span>
            </button>
          `).join('');
          return `
            <div class="api-try-color" id="${fieldId}" data-field="${name}" data-value="${selected.hex}">
              <button type="button" class="api-try-color-btn" aria-haspopup="true" aria-expanded="false">
                <span class="api-try-color-swatch" style="background:${selected.hex}"></span>
                <span class="api-try-color-label">${selected.name}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
              </button>
              <div class="api-try-color-dropdown">${options}</div>
            </div>
          `;
        }
        if (prop && (prop.format === 'binary' || prop.contentMediaType)) {
          return `
            <div class="api-try-file">
              <label class="api-try-file-btn" for="${fieldId}">${t('api.chooseFile')}</label>
              <span class="api-try-file-name" id="${fieldId}-name">${t('api.noFileChosen')}</span>
              <input class="api-try-file-input" id="${fieldId}" data-field="${name}" type="file" accept="image/png,image/jpeg,image/webp" ${required ? 'required' : ''} />
            </div>
          `;
        }
        if (prop && (prop.type === 'integer' || prop.type === 'number')) {
          return `<input class="api-try-input" id="${fieldId}" data-field="${name}" type="number" ${required ? 'required' : ''} />`;
        }
        const maxLength = prop && prop.maxLength ? `maxlength="${prop.maxLength}"` : '';
        return `<input class="api-try-input" id="${fieldId}" data-field="${name}" type="text" ${maxLength} ${required ? 'required' : ''} />`;
      }

      function renderTryForm(spec, path, method, operation, formId) {
        const params = operation.parameters || [];
        const body = operation.requestBody;
        let bodyKind = '';
        let bodySchema = null;
        if (body && body.content) {
          if (body.content['application/json']) {
            bodyKind = 'json';
            bodySchema = resolveSchema(spec, body.content['application/json'].schema);
          } else if (body.content['multipart/form-data']) {
            bodyKind = 'multipart';
            bodySchema = resolveSchema(spec, body.content['multipart/form-data'].schema);
          }
        }

        const required = new Set((bodySchema && bodySchema.required) || []);
        const bodyFields = bodySchema && bodySchema.properties
          ? Object.entries(bodySchema.properties).map(([name, prop]) => `
              <div>
                <label class="api-try-label" for="${formId}-${name}">${name}</label>
                ${fieldInputHtml(`${formId}-${name}`, name, prop, required.has(name))}
              </div>
            `).join('')
          : '';

        const paramFields = params.map((p) => `
          <div>
            <label class="api-try-label" for="${formId}-${p.name}">${p.name} · ${p.in}</label>
            ${fieldInputHtml(`${formId}-${p.name}`, p.name, p.schema, p.required)}
          </div>
        `).join('');

        return `
          <div class="api-try" id="${formId}" data-path="${path}" data-method="${method}" data-body-kind="${bodyKind}">
            ${(bodyFields || paramFields) ? `<div class="api-try-fields">${paramFields}${bodyFields}</div>` : ''}
            <button type="button" class="api-try-btn" data-action="execute">${t('api.execute')}</button>
            <pre class="api-try-response"></pre>
          </div>
        `;
      }

      function endpointHtml(spec, path, method, operation, index) {
        const summary = operation.summary || operation.description || '';
        return `
          <article class="api-endpoint">
            <div class="api-endpoint-head">
              <span class="api-method ${method}">${method.toUpperCase()}</span>
              <code class="api-path">${path}</code>
            </div>
            ${summary ? `<p class="api-summary">${summary}</p>` : ''}
            ${renderParams(operation)}
            ${renderRequestFields(spec, operation)}
            ${renderResponses(operation)}
            ${renderTryForm(spec, path, method, operation, `ep-${index}`)}
          </article>
        `;
      }

      async function loadSpec() {
        try {
          const res = await fetch(`${API_BASE_URL}/openapi.json`);
          if (!res.ok) throw new Error('bad response');
          const spec = await res.json();

          const groups = new Map();
          let epIndex = 0;
          Object.entries(spec.paths || {}).forEach(([path, methods]) => {
            METHOD_ORDER.forEach((method) => {
              const operation = methods[method];
              if (!operation) return;
              const tag = (operation.tags && operation.tags[0]) || 'Other';
              if (!groups.has(tag)) groups.set(tag, []);
              groups.get(tag).push({ path, method, operation, index: epIndex++ });
            });
          });

          const orderedTags = [
            ...GROUP_ORDER.filter((tag) => groups.has(tag)),
            ...[...groups.keys()].filter((tag) => !GROUP_ORDER.includes(tag)),
          ];

          groupsEl.innerHTML = orderedTags.map((tag) => `
            <section class="api-group">
              <h2 class="api-group-title">${tag}</h2>
              <div class="api-endpoints">
                ${groups.get(tag).map((e) => endpointHtml(spec, e.path, e.method, e.operation, e.index)).join('')}
              </div>
            </section>
          `).join('');

          statusEl.style.display = 'none';
        } catch {
          statusEl.textContent = t('api.error');
          statusEl.classList.add('error');
        }
      }

      function fieldValue(el) {
        if (el.classList.contains('api-try-color')) return el.dataset.value;
        return el.value;
      }

      groupsEl.addEventListener('change', (e) => {
        const input = e.target.closest('input[type="file"][data-field]');
        if (!input) return;
        const nameEl = document.getElementById(`${input.id}-name`);
        if (nameEl) nameEl.textContent = input.files[0] ? input.files[0].name : t('api.noFileChosen');
      });

      groupsEl.addEventListener('click', (e) => {
        const option = e.target.closest('.api-try-color-option');
        if (option) {
          const wrapper = option.closest('.api-try-color');
          wrapper.dataset.value = option.dataset.value;
          wrapper.querySelector('.api-try-color-btn .api-try-color-swatch').style.background = option.dataset.value;
          wrapper.querySelector('.api-try-color-btn .api-try-color-label').textContent = option.querySelector('.api-try-color-option-label').textContent;
          wrapper.querySelectorAll('.api-try-color-option').forEach((o) => o.classList.toggle('active', o === option));
          wrapper.classList.remove('open');
          return;
        }
        const trigger = e.target.closest('.api-try-color-btn');
        if (trigger) {
          const wrapper = trigger.closest('.api-try-color');
          const isOpen = wrapper.classList.toggle('open');
          trigger.setAttribute('aria-expanded', isOpen);
        }
      });

      document.addEventListener('click', (e) => {
        groupsEl.querySelectorAll('.api-try-color.open').forEach((wrapper) => {
          if (wrapper.contains(e.target)) return;
          wrapper.classList.remove('open');
          wrapper.querySelector('.api-try-color-btn').setAttribute('aria-expanded', 'false');
        });
      });

      groupsEl.addEventListener('click', async (e) => {
        const btn = e.target.closest('[data-action="execute"]');
        if (!btn) return;
        const container = btn.closest('.api-try');
        const responseEl = container.querySelector('.api-try-response');
        const path = container.dataset.path;
        const method = container.dataset.method;
        const bodyKind = container.dataset.bodyKind;
        const inputs = container.querySelectorAll('[data-field]');

        const opts = { method: method.toUpperCase() };
        if (bodyKind === 'json') {
          const payload = {};
          inputs.forEach((el) => {
            payload[el.dataset.field] = el.type === 'number' ? Number(el.value) : fieldValue(el);
          });
          opts.headers = { 'Content-Type': 'application/json' };
          opts.body = JSON.stringify(payload);
        } else if (bodyKind === 'multipart') {
          const fd = new FormData();
          inputs.forEach((el) => {
            if (el.type === 'file') {
              if (el.files[0]) fd.append(el.dataset.field, el.files[0]);
            } else {
              fd.append(el.dataset.field, fieldValue(el));
            }
          });
          opts.body = fd;
        }

        btn.disabled = true;
        const originalLabel = btn.textContent;
        btn.textContent = t('api.sending');
        responseEl.textContent = '';
        responseEl.className = 'api-try-response';

        try {
          const res = await fetch(`${API_BASE_URL}${path}`, opts);
          const raw = await res.text();
          let bodyText = raw;
          try { bodyText = JSON.stringify(JSON.parse(raw), null, 2); } catch { /* not JSON, show as-is */ }
          responseEl.textContent = `${res.status} ${res.statusText}` + (bodyText ? `\n\n${bodyText}` : '');
          responseEl.classList.add(res.ok ? 'ok' : 'err');
        } catch (err) {
          responseEl.textContent = `${t('api.networkError')}: ${err.message}`;
          responseEl.classList.add('err');
        } finally {
          btn.disabled = false;
          btn.textContent = originalLabel;
        }
      });

      loadSpec();
    })();
  </script>
</body>
</html>

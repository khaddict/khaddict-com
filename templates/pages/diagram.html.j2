    const searchKbd = document.getElementById('search-kbd');
    const helpKbdMultiselect = document.getElementById('help-kbd-multiselect');
    if (window.matchMedia('(pointer: coarse)').matches) searchKbd.style.display = 'none';
    if (/Mac|iPhone|iPad|iPod/.test(navigator.platform || navigator.userAgent)) helpKbdMultiselect.textContent = '⌘+Click';
  })();

  document.addEventListener('DOMContentLoaded', () => {
    const cmdkOverlay = document.getElementById('cmdk-overlay');
    const cmdkInput = document.getElementById('cmdk-input');
    new MutationObserver(() => {
      if (!cmdkOverlay.classList.contains('open') && document.activeElement === cmdkInput) cmdkInput.blur();
    }).observe(cmdkOverlay, { attributes: true, attributeFilter: ['class'] });
  });


  (function () {
    const btn = document.getElementById('help-btn');
    const dropdown = document.getElementById('help-dropdown');
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = dropdown.classList.toggle('open');
      btn.setAttribute('aria-expanded', open);
    });
    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target) && e.target !== btn) {
        dropdown.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  })();

  (function () {
    const POPOVERS = [
      { btn: 'status-btn', dropdown: 's-dropdown' },
      { btn: 'lang-btn', dropdown: 'lang-dropdown' },

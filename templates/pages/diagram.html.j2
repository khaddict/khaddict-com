{% from "partials/js_str.j2" import js_str %}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script>
{% include "partials/theme_toggle.js.j2" %}
  </script>
  <title>{{ i18n['title.diagram'] }}</title>
  <meta name="description" content="{{ meta_description }}" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="{{ og_url }}" />
  <meta property="og:title" content="{{ i18n['title.diagram'] }}" />
  <meta property="og:description" content="{{ meta_description }}" />
  <meta property="og:image" content="{{ brand_icon_src }}" />
  <meta property="og:locale" content="{{ og_locale }}" />
  <meta property="og:locale:alternate" content="{{ og_locale_alternate }}" />
  <link rel="canonical" href="{{ canonical_url }}" />
  <link rel="alternate" hreflang="en" href="{{ hreflang_en_href }}" />
  <link rel="alternate" hreflang="fr" href="{{ hreflang_fr_href }}" />
  <link rel="alternate" hreflang="x-default" href="{{ hreflang_x_default_href }}" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="{{ i18n['title.diagram'] }}" />
  <meta name="twitter:image" content="{{ brand_icon_src }}" />
  <link rel="icon" href="{{ brand_icon_src }}" type="image/png" />
  <link rel="apple-touch-icon" href="{{ brand_icon_src }}" />

{% include "partials/matomo.html.j2" %}
  <style>
{% include "partials/head_tokens.css.j2" %}
{% include "partials/status_widget.css.j2" %}
  .bandeau { z-index: 60; }
  :root {
    --flow-gap: 96px;
    --vlan-core: #7C5CBF;
    --vlan-core-bg: rgba(124, 92, 191, .08);
    --vlan-admin: #A6790F;
    --vlan-admin-bg: rgba(166, 121, 15, .08);
    --vlan-infra: #1C7F97;
    --vlan-infra-bg: rgba(28, 127, 151, .08);
    --vlan-edge: #C93E82;
    --vlan-edge-bg: rgba(201, 62, 130, .08);
    --vlan-iot: #1A7557;
    --vlan-iot-bg: rgba(26, 117, 87, .08);
    --vlan-ext: #C43B3B;
    --vlan-ext-bg: rgba(196, 59, 59, .08);
    --vlan-k8s: #1E4E85;
    --vlan-k8s-bg: rgba(30, 78, 133, .08);
    --vlan-cloud: #2563EB;
    --vlan-cloud-bg: rgba(37, 99, 235, .08);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --vlan-core: #B39DDB;
      --vlan-core-bg: rgba(179, 157, 219, .1);
      --vlan-admin: #F0C674;
      --vlan-admin-bg: rgba(240, 198, 116, .1);
      --vlan-infra: #8ED2E0;
      --vlan-infra-bg: rgba(142, 210, 224, .1);
      --vlan-edge: #F5A8D6;
      --vlan-edge-bg: rgba(245, 168, 214, .1);
      --vlan-iot: #A5D6C1;
      --vlan-iot-bg: rgba(165, 214, 193, .1);
      --vlan-ext: #F59B9B;
      --vlan-ext-bg: rgba(245, 155, 155, .1);
      --vlan-k8s: #5B93C4;
      --vlan-k8s-bg: rgba(91, 147, 196, .1);
      --vlan-cloud: #93C5FD;
      --vlan-cloud-bg: rgba(147, 197, 253, .1);
    }
  }

  :root[data-theme="dark"] {
    --vlan-core: #B39DDB;
    --vlan-core-bg: rgba(179, 157, 219, .1);
    --vlan-admin: #F0C674;
    --vlan-admin-bg: rgba(240, 198, 116, .1);
    --vlan-infra: #8ED2E0;
    --vlan-infra-bg: rgba(142, 210, 224, .1);
    --vlan-edge: #F5A8D6;
    --vlan-edge-bg: rgba(245, 168, 214, .1);
    --vlan-iot: #A5D6C1;
    --vlan-iot-bg: rgba(165, 214, 193, .1);
    --vlan-ext: #F59B9B;
    --vlan-ext-bg: rgba(245, 155, 155, .1);
    --vlan-k8s: #5B93C4;
    --vlan-k8s-bg: rgba(91, 147, 196, .1);
    --vlan-cloud: #93C5FD;
    --vlan-cloud-bg: rgba(147, 197, 253, .1);
  }

  body { height: 100vh; overflow: hidden; }

  .topbar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: .75rem 1.25rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    flex-shrink: 0;
    flex-wrap: wrap;
    z-index: 50;
  }
  .topbar h1 {
    font-size: .95rem;
    font-weight: 700;
    margin: 0;
    letter-spacing: -.01em;
  }
  .topbar .sub {
    font-size: .7rem;
    color: var(--muted);
  }
  .legend {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-left: auto;
    flex-wrap: wrap;
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: .4rem;
    font-size: .68rem;
    color: var(--muted);
    background: none;
    border: 1px solid transparent;
    border-radius: 12px;
    padding: .2rem .5rem;
    cursor: pointer;
    font-family: inherit;
    transition: border-color .12s ease, color .12s ease;
  }
  .legend-item:hover { color: var(--text); }
  .legend-item.active { border-color: var(--legend-color); color: var(--legend-color); }

  .search-wrap { position: relative; display: flex; align-items: center; }
  .search-icon {
    position: absolute;
    left: .65rem;
    width: 13px; height: 13px;
    color: var(--muted);
    pointer-events: none;
  }
  .search-input {
    width: 230px;
    height: 30px;
    padding: 0 2.9rem 0 1.9rem;
    border-radius: 15px;
    border: 1px solid var(--border);
    background: none;
    color: var(--text);
    font-family: inherit;
    font-size: .72rem;
    transition: border-color .15s ease, background .15s ease;
  }
  .search-input:hover { border-color: var(--accent); background: rgba(139, 92, 246, .08); }
  .search-input:focus { outline: none; border-color: var(--accent); background: rgba(139, 92, 246, .08); }
  .search-input::placeholder { color: var(--muted); }
  .search-kbd {
    position: absolute;
    top: 50%; right: .5rem;
    transform: translateY(-50%);
    font-family: 'JetBrains Mono', monospace;
    font-size: .62rem;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: .05rem .35rem;
    pointer-events: none;
    white-space: nowrap;
    background: var(--bg);
  }
  #cmdk-kbd {
    position: static;
    top: auto; right: auto;
    transform: none;
    font-size: .64rem;
    background: none;
  }
  .search-results {
    position: absolute;
    top: calc(100% + .5rem);
    left: 0;
    width: 260px;
    max-height: 280px;
    overflow-y: auto;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 12px 32px var(--shadow);
    padding: .4rem;
    display: none;
    z-index: 60;
  }
  .search-results.open { display: block; }
  .search-result-item {
    display: flex;
    align-items: center;
    gap: .55rem;
    width: 100%;
    padding: .45rem .55rem;
    border-radius: 7px;
    border: none;
    background: none;
    cursor: pointer;
    font-family: inherit;
    text-align: left;
    color: inherit;
  }
  .search-result-item:hover, .search-result-item.highlighted { background: var(--surface-2); }
  .search-result-item .node-icon { width: 22px; height: 22px; flex-shrink: 0; }
  .search-result-item .node-icon svg { width: 12px; height: 12px; }
  .search-result-name { font-size: .76rem; font-weight: 600; }
  .search-result-ip { font-size: .64rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .search-empty { font-size: .72rem; color: var(--muted); padding: .6rem; text-align: center; }
  .legend-dot {
    width: 9px; height: 9px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .zoom-controls {
    display: flex;
    gap: .35rem;
  }
  .zoom-controls button {
    width: 26px; height: 26px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--text);
    cursor: pointer;
    font-family: inherit;
    font-size: .85rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .zoom-controls button:hover { border-color: var(--accent); color: var(--accent); }

  .help-wrap { position: relative; }
  #help-btn { font-weight: 700; }
  .help-dropdown {
    position: absolute;
    top: calc(100% + .6rem);
    right: 0;
    width: 580px;
    max-width: calc(100vw - 2rem);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 12px 32px var(--shadow);
    padding: .9rem 1rem;
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
    transition: opacity .15s ease, transform .15s ease;
    z-index: 200;
  }
  .help-dropdown.open { opacity: 1; transform: translateY(0); pointer-events: auto; }
  .help-title {
    font-size: .68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .04em;
    color: var(--muted);
    margin: 0 0 .6rem;
  }
  .help-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .5rem; }
  .help-list li {
    font-size: .74rem;
    display: grid;
    grid-template-columns: 210px 1fr;
    align-items: center;
    gap: .7rem;
    white-space: nowrap;
  }
  .help-key { display: flex; gap: .25rem; color: var(--muted); }
  .help-list kbd {
    font-family: 'JetBrains Mono', monospace;
    font-size: .66rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: .1rem .4rem;
    white-space: nowrap;
  }

  .viewport {
    flex: 1;
    position: relative;
    overflow: hidden;
    cursor: grab;
    background-image: radial-gradient(var(--border) 1px, transparent 1px);
    background-size: 22px 22px;
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
  }

  .viewport.grabbing { cursor: grabbing; }
  .viewport.grabbing .node-card { pointer-events: none; }

  .canvas {
    position: absolute;
    top: 0; left: 0;
    transform-origin: 0 0;
    will-change: transform;
  }

  svg.edges {
    position: absolute;
    top: 0; left: 0;
    overflow: visible;
    pointer-events: none;
    z-index: 2;
  }
  svg.edges .edge-line {
    animation: edge-flow 1.1s linear infinite;
  }
  @keyframes edge-flow {
    to { stroke-dashoffset: -14; }
  }
  svg.edges .edge-pulse {
    animation: edge-pulse-fade 2.4s ease-in-out infinite;
  }
  @keyframes edge-pulse-fade {
    0%, 100% { opacity: 0; }
    50% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    svg.edges .edge-line { animation: none; }
    svg.edges .edge-pulse { animation: none; opacity: .9; }
  }

  .edge-label {
    font-size: 9px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 600;
  }
  .edge-label-bg {
    fill: var(--surface);
    stroke: var(--border);
    stroke-width: 1;
  }
  .edge-label-text { fill: var(--muted); }

  .host-frame {
    position: relative;
    border: 1.5px dashed var(--border);
    border-radius: 16px;
    padding: 2.75rem 2rem 2rem;
    background: var(--surface);
  }
  .host-title {
    position: absolute;
    top: -1px; left: 1.5rem;
    transform: translateY(-50%);
    background: var(--bg);
    padding: .2rem .7rem;
    font-size: .72rem;
    font-weight: 700;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: .4rem;
    white-space: nowrap;
  }
  .host-title svg { width: 13px; height: 13px; flex-shrink: 0; }

  .topology {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .canvas-stack { display: flex; flex-direction: column; align-items: center; }
  .hub-row { margin-bottom: var(--flow-gap); display: flex; justify-content: center; }
  .core-zone .node-list, .ext-zone .node-list, .cloud-zone .node-list { flex-direction: row; flex-wrap: wrap; justify-content: center; gap: 1.5rem; }
  .ext-row { margin-bottom: var(--flow-gap); display: flex; justify-content: center; }
  .cloud-row { margin-bottom: var(--flow-gap); display: flex; justify-content: center; }
  .flow-badge {
    position: absolute;
    top: -6px; right: -6px;
    min-width: 15px;
    height: 15px;
    padding: 0 3px;
    border-radius: 8px;
    background: var(--zone-color);
    color: var(--surface);
    font-size: .58rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--bg);
  }

  .branch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--flow-gap);
    align-items: start;
    width: 100%;
  }

  .vlan-zone {
    border-radius: 12px;
    border: 1.5px solid var(--zone-color);
    background: var(--zone-bg);
    padding: 1rem;
    box-shadow: 0 10px 28px -14px var(--zone-color);
  }
  .vlan-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: .8rem;
    padding-bottom: .6rem;
    border-bottom: 1px solid var(--border);
  }
  .vlan-name {
    font-size: .78rem;
    font-weight: 700;
    color: var(--zone-color);
    letter-spacing: .02em;
    display: inline-flex;
    align-items: center;
    gap: .4rem;
  }
  .vlan-icon { width: 14px; height: 14px; display: inline-flex; }
  .vlan-icon svg { width: 100%; height: 100%; }
  .vlan-cidr {
    font-size: .64rem;
    color: var(--muted);
  }

  .node-list { display: flex; flex-direction: column; gap: .6rem; }

  .k8s-subgroup {
    border: 1px dashed var(--zone-color);
    border-radius: 10px;
    padding: .6rem;
    margin-top: .2rem;
  }
  .k8s-subgroup .sub-label {
    font-size: .62rem;
    color: var(--zone-color);
    font-weight: 700;
    margin-bottom: .5rem;
    display: block;
  }
  .k8s-subgroup .node-list { gap: .5rem; }

  .node-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: .55rem;
    padding: .5rem .6rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface);
    cursor: pointer;
    transition: border-color .12s ease, transform .12s ease, box-shadow .12s ease;
    text-align: left;
    width: 220px;
    flex-shrink: 0;
    font-family: inherit;
    color: inherit;
    box-shadow: 0 8px 20px -14px var(--zone-color);
  }
  .core-zone .node-card, .ext-zone .node-card, .cloud-zone .node-card { flex: 0 0 220px; }
  .node-card:hover {
    border-color: var(--zone-color);
    transform: translateY(-1px);
    box-shadow: 0 6px 16px -6px var(--zone-color);
  }
  .node-card.focused {
    border-color: var(--zone-color);
    box-shadow: 0 0 0 3px var(--zone-bg), 0 10px 24px -8px var(--zone-color);
    transform: scale(1.06);
    z-index: 3;
    position: relative;
  }
  .node-card.related {
    border-color: var(--zone-color);
  }
  .node-card.dimmed {
    opacity: .3;
  }
  .node-card, .vlan-zone {
    transition: opacity .18s ease, transform .18s ease, border-color .18s ease, box-shadow .18s ease;
  }
  .node-card {
    opacity: 1;
    animation: node-in .5s cubic-bezier(.2,.7,.3,1) backwards;
    animation-delay: calc(var(--stagger, 0) * 40ms);
  }
  @keyframes node-in {
    from { opacity: 0; transform: translateY(6px) scale(.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  .vlan-zone {
    opacity: 0;
    animation: zone-in .45s ease forwards;
    animation-delay: calc(var(--zone-order, 0) * 90ms);
  }
  @keyframes zone-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .host-frame {
    animation: frame-in .4s ease both;
  }
  @keyframes frame-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .node-card, .vlan-zone, .host-frame { animation: none !important; opacity: 1 !important; }
  }
  .node-icon {
    width: 26px; height: 26px;
    border-radius: 6px;
    background: var(--zone-bg);
    color: var(--zone-color);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .node-icon svg { width: 14px; height: 14px; }
  .node-meta { min-width: 0; flex: 1; }
  .node-name {
    font-size: .74rem;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .node-ip {
    font-size: .62rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .panel {
    position: absolute;
    top: 0; right: 0;
    bottom: 0;
    width: min(360px, 100%);
    background: var(--surface);
    border-left: 1px solid var(--border);
    box-shadow: -20px 0 40px var(--shadow);
    transform: translateX(100%);
    transition: transform .2s ease;
    z-index: 11;
    display: flex;
    flex-direction: column;
  }
  .panel.open { transform: translateX(0); }

  .panel-head {
    display: flex;
    align-items: center;
    gap: .8rem;
    padding: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .panel-icon {
    width: 38px; height: 38px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .panel-icon svg { width: 19px; height: 19px; }
  .panel-head h2 { margin: 0; font-size: 1rem; }
  .panel-head .vlan-tag {
    font-size: .64rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .03em;
  }
  .panel-close {
    margin-left: auto;
    width: 28px; height: 28px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: none;
    color: var(--muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .panel-close:hover { color: var(--text); border-color: var(--text); }

  .panel-body { padding: 1.25rem; overflow-y: auto; flex: 1; }
  .panel-desc {
    font-size: .82rem;
    line-height: 1.6;
    margin: 0 0 1.25rem;
  }
  .desc-link {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font: inherit;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }
  .desc-link:hover { opacity: .8; }

  .panel-section-title {
    font-size: .66rem;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: var(--muted);
    margin: 0 0 .6rem;
  }
  .conn-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: .5rem;
  }
  .conn-header .panel-section-title { margin-bottom: .6rem; }
  .conn-toggle-all {
    background: none;
    border: none;
    color: var(--accent);
    font-size: .66rem;
    font-family: inherit;
    cursor: pointer;
    padding: 0;
    margin-bottom: .6rem;
  }
  .conn-toggle-all:hover { text-decoration: underline; }

  .kv-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: .5rem 1rem;
    font-size: .76rem;
    margin-bottom: 1.5rem;
  }
  .kv-grid dt { color: var(--muted); }
  .kv-grid dd { margin: 0; font-variant-numeric: tabular-nums; }

  .port-row {
    display: flex;
    align-items: center;
    gap: .6rem;
    padding: .5rem .6rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    margin-bottom: .5rem;
    font-size: .72rem;
  }
  .port-num {
    font-weight: 700;
    background: var(--surface-2);
    border-radius: 5px;
    padding: .15rem .45rem;
    font-variant-numeric: tabular-nums;
  }
  .port-label {
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  .conn-row {
    display: flex;
    align-items: flex-start;
    gap: .5rem;
    font-size: .72rem;
    padding: .4rem 0;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    transition: opacity .12s ease;
  }
  .conn-row:last-child { border-bottom: none; }
  .conn-row.off { opacity: .4; }
  .conn-check { accent-color: var(--accent); cursor: pointer; flex-shrink: 0; margin-top: .15rem; }
  .conn-row-text { display: flex; flex-direction: column; gap: .15rem; min-width: 0; flex: 1; }
  .conn-row-main { display: flex; align-items: center; gap: .5rem; }
  .conn-arrow { color: var(--muted); }
  .conn-port {
    margin-left: auto;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .conn-label { color: var(--muted); font-size: .64rem; }

  .conn-group { border-bottom: 1px solid var(--border); }
  .conn-group:last-child { border-bottom: none; }
  .conn-group-header {
    display: flex;
    align-items: center;
    gap: .45rem;
    width: 100%;
    padding: .4rem 0;
    border: none;
    background: none;
    color: var(--text);
    font-family: inherit;
    font-size: .72rem;
    font-weight: 600;
    cursor: pointer;
    text-align: left;
  }
  .conn-group-chevron { width: 12px; height: 12px; flex-shrink: 0; color: var(--muted); transition: transform .15s ease; }
  .conn-group-header.collapsed .conn-group-chevron { transform: rotate(-90deg); }
  .conn-group-list { display: flex; flex-direction: column; }
  .conn-group-list.collapsed { display: none; }
  .conn-group-list .conn-row { padding-left: 1.2rem; border-bottom: none; }
  .conn-group-list .conn-row:not(:last-child) { border-bottom: 1px solid var(--border); }

  ::-webkit-scrollbar { width: 8px; }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

{% include "partials/responsive.css.j2" %}
  </style>
</head>
<body>
{% include "partials/header.html.j2" %}
<div class="topbar">

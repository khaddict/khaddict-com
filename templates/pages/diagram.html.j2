        <li><span class="help-key"><kbd>Drag</kbd></span><span>Pan map</span></li>
        <li><span class="help-key"><kbd>Scroll / Pinch</kbd></span><span>Zoom</span></li>
      </ul>
    </div>
  </div>
</div>

<div class="viewport" id="viewport">
  <div class="canvas" id="canvas">
    <svg class="edges" id="edges"></svg>

  let scale = 1, tx = 40, ty = 20, isPanning = false, startX = 0, startY = 0;

  function applyTransform() {
    canvas.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
  }

  function fitToView() {
    const vpRect = viewport.getBoundingClientRect();
    const stackEl = document.getElementById('canvasStack');
    const naturalW = stackEl.scrollWidth + 60;
    const naturalH = stackEl.scrollHeight + 40;
    const s = Math.min((vpRect.width - 60) / naturalW, (vpRect.height - 60) / naturalH, 1);
    scale = Math.max(s, 0.3);
    tx = Math.max((vpRect.width - naturalW * scale) / 2, 20);
    ty = Math.max((vpRect.height - naturalH * scale) / 2, 20);
    applyTransform();
  }

  let panMoved = false, panStartClientX = 0, panStartClientY = 0;

  viewport.addEventListener('mousedown', (e) => {
    if (e.target.closest('.node-card') || e.target.closest('.panel')) return;
    isPanning = true;
    panMoved = false;
    panStartClientX = e.clientX;
    panStartClientY = e.clientY;
    viewport.classList.add('grabbing');
    startX = e.clientX - tx;
    startY = e.clientY - ty;
  });
  window.addEventListener('mousemove', (e) => {
    if (!isPanning) return;
    if (Math.hypot(e.clientX - panStartClientX, e.clientY - panStartClientY) > 4) panMoved = true;
    tx = e.clientX - startX;
    ty = e.clientY - startY;
    applyTransform();
  });
  window.addEventListener('mouseup', () => {
    if (isPanning && !panMoved) { clearFilter(); setSelection([]); }
    isPanning = false;
    viewport.classList.remove('grabbing');
  });

  viewport.addEventListener('wheel', (e) => {
    if (e.target.closest('.panel')) return;
    e.preventDefault();
    const delta = e.deltaY > 0 ? -0.08 : 0.08;
    const newScale = Math.min(Math.max(scale + delta, 0.3), 2);
    scale = newScale;
    applyTransform();
  }, { passive: false });

  let pinchStartDist = 0, pinchStartScale = 1;
  const touchDist = (touches) => Math.hypot(touches[0].clientX - touches[1].clientX, touches[0].clientY - touches[1].clientY);

  let touchMoved = false, touchStartClientX = 0, touchStartClientY = 0;

  viewport.addEventListener('touchstart', (e) => {
    if (e.touches.length === 1) {
      if (e.target.closest('.node-card') || e.target.closest('.panel')) return;
      isPanning = true;
      touchMoved = false;
      touchStartClientX = e.touches[0].clientX;
      touchStartClientY = e.touches[0].clientY;
      startX = e.touches[0].clientX - tx;
      startY = e.touches[0].clientY - ty;
    } else if (e.touches.length === 2) {
      isPanning = false;
      touchMoved = true;
      pinchStartDist = touchDist(e.touches);
      pinchStartScale = scale;
    }
  }, { passive: true });

  viewport.addEventListener('touchmove', (e) => {
    if (e.touches.length === 1 && isPanning) {
      if (Math.hypot(e.touches[0].clientX - touchStartClientX, e.touches[0].clientY - touchStartClientY) > 4) touchMoved = true;
      e.preventDefault();
      tx = e.touches[0].clientX - startX;
      ty = e.touches[0].clientY - startY;
      applyTransform();
    } else if (e.touches.length === 2) {
      e.preventDefault();
      const ratio = touchDist(e.touches) / (pinchStartDist || 1);
      scale = Math.min(Math.max(pinchStartScale * ratio, 0.3), 2);
      applyTransform();
    }
  }, { passive: false });

  viewport.addEventListener('touchend', () => {
    if (isPanning && !touchMoved) { clearFilter(); setSelection([]); }

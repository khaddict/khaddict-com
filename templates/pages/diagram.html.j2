  document.getElementById('zoom-reset').addEventListener('click', fitToView);

  const FLOW_GAP = 96;
  const CARD_CLEARANCE = 12;

  let selectedIds = new Set();
  let activeConnKeys = new Set();
  let activeVlanIds = new Set();

  function getGeometry() {
    const canvasRect = canvas.getBoundingClientRect();
    const toRect = (r) => ({
      left: (r.left - canvasRect.left) / scale,
      right: (r.right - canvasRect.left) / scale,
      top: (r.top - canvasRect.top) / scale,
      bottom: (r.bottom - canvasRect.top) / scale,
    });
    const nodes = new Map();
    document.querySelectorAll('.node-card').forEach((el) => {
      const rect = toRect(el.getBoundingClientRect());
      nodes.set(el.dataset.id, { ...rect, midX: (rect.left + rect.right) / 2, midY: (rect.top + rect.bottom) / 2 });
    });
    const zones = new Map();
    VLANS.forEach((v) => {
      const el = document.getElementById(`zone-${v.id}`);
      if (el) zones.set(v.id, toRect(el.getBoundingClientRect()));
    });
    const borderBoxes = Array.from(document.querySelectorAll('.k8s-subgroup')).map((el) => toRect(el.getBoundingClientRect()));
    return {
      nodes, zones, borderBoxes,
      width: document.getElementById('canvasStack').scrollWidth,
      height: document.getElementById('canvasStack').scrollHeight,
    };
  }

  function buildTracks(geometry) {
    const rowIds = ['cloud', 'ext', hub.vlan];
    const rowZones = rowIds.map((id) => geometry.zones.get(id));
    const gridIds = VLANS.map((v) => v.id).filter((id) => !rowIds.includes(id));
    const gridZones = gridIds.map((id) => geometry.zones.get(id)).filter(Boolean);
    const gridTop = gridZones.length ? Math.min(...gridZones.map((z) => z.top)) : null;
    return {
      rowIds, gridIds,
      cloudLanY: rowZones[0] && rowZones[1] ? (rowZones[0].bottom + rowZones[1].top) / 2 : null,
      lanCoreY: rowZones[1] && rowZones[2] ? (rowZones[1].bottom + rowZones[2].top) / 2 : null,
      coreGridY: rowZones[2] && gridTop != null ? (rowZones[2].bottom + gridTop) / 2 : null,
    };
  }

  const rectsOverlap = (a, b) => a.left < b.right && a.right > b.left && a.top < b.bottom && a.bottom > b.top;

  const segmentRect = (p1, p2) => ({
    left: Math.min(p1.x, p2.x) - 1, right: Math.max(p1.x, p2.x) + 1,
    top: Math.min(p1.y, p2.y) - 1, bottom: Math.max(p1.y, p2.y) + 1,
  });

  function segmentHitsCards(p1, p2, geometry, excludeIds) {
    const rect = segmentRect(p1, p2);
    for (const [id, r] of geometry.nodes) {
      if (excludeIds.has(id)) continue;
      const padded = { left: r.left - CARD_CLEARANCE, right: r.right + CARD_CLEARANCE, top: r.top - CARD_CLEARANCE, bottom: r.bottom + CARD_CLEARANCE };
      if (rectsOverlap(rect, padded)) return true;
    }
    return false;
  }

  function segmentHitsForeignVlans(p1, p2, geometry, ownVlans) {
    const rect = segmentRect(p1, p2);
    for (const [vlanId, r] of geometry.zones) {
      if (ownVlans.has(vlanId)) continue;
      if (rectsOverlap(rect, r)) return true;
    }
    return false;
  }

  function isSegmentClear(p1, p2, geometry, ownVlans, excludeIds) {
    if (Math.abs(p1.x - p2.x) > 0.5 && Math.abs(p1.y - p2.y) > 0.5) return false;
    return !segmentHitsCards(p1, p2, geometry, excludeIds) && !segmentHitsForeignVlans(p1, p2, geometry, ownVlans);
  }

  function pathFullyClear(points, ctx) {
    for (let i = 0; i < points.length - 1; i++) {
      if (!isSegmentClear(points[i], points[i + 1], ctx.geometry, ctx.ownVlans, ctx.excludeIds)) return false;
    }
    return true;
  }

  function getCandidatePorts(rect) {
    return {
      N: { x: rect.midX, y: rect.top },
      S: { x: rect.midX, y: rect.bottom },
      E: { x: rect.right, y: rect.midY },
      W: { x: rect.left, y: rect.midY },
    };
  }

  function makeStraightCandidates(fp, tp) {
    if (Math.abs(fp.x - tp.x) < 0.5 || Math.abs(fp.y - tp.y) < 0.5) return [[fp, tp]];
    return [];
  }

  function makeLCandidates(fp, tp) {
    return [
      [fp, { x: tp.x, y: fp.y }, tp],
      [fp, { x: fp.x, y: tp.y }, tp],
    ];
  }

  function gapCoordinates(geometry, axis, lo, hi, excludeIds) {
    const relevant = [];
    geometry.nodes.forEach((r, id) => {
      if (excludeIds.has(id)) return;
      const inRange = axis === 'x' ? !(r.bottom < lo || r.top > hi) : !(r.right < lo || r.left > hi);
      if (inRange) relevant.push(r);
    });
    if (!relevant.length) return [];
    relevant.sort((a, b) => (axis === 'x' ? a.left - b.left : a.top - b.top));
    const coords = [];
    for (let i = 0; i < relevant.length - 1; i++) {
      const a = relevant[i], b = relevant[i + 1];
      const gapLo = axis === 'x' ? a.right : a.bottom, gapHi = axis === 'x' ? b.left : b.top;
      if (gapHi > gapLo) coords.push((gapLo + gapHi) / 2);
    }
    coords.push((axis === 'x' ? relevant[0].left : relevant[0].top) - 20);
    coords.push((axis === 'x' ? relevant[relevant.length - 1].right : relevant[relevant.length - 1].bottom) + 20);
    return coords;
  }

  function makeDoglegCandidates(fp, tp, fromRect, toRect, tracks, geometry, excludeIds) {
    const xs = new Set([fp.x, tp.x, fromRect.left - 20, fromRect.right + 20, toRect.left - 20, toRect.right + 20]);
    const ys = new Set([fp.y, tp.y, fromRect.top - 20, fromRect.bottom + 20, toRect.top - 20, toRect.bottom + 20]);
    [tracks.cloudLanY, tracks.lanCoreY, tracks.coreGridY].forEach((y) => { if (y != null) ys.add(y); });
    gapCoordinates(geometry, 'x', Math.min(fp.y, tp.y), Math.max(fp.y, tp.y), excludeIds).forEach((x) => xs.add(x));
    gapCoordinates(geometry, 'y', Math.min(fp.x, tp.x), Math.max(fp.x, tp.x), excludeIds).forEach((y) => ys.add(y));
    const candidates = [];
    ys.forEach((midY) => candidates.push([fp, { x: fp.x, y: midY }, { x: tp.x, y: midY }, tp]));
    xs.forEach((midX) => candidates.push([fp, { x: midX, y: fp.y }, { x: midX, y: tp.y }, tp]));
    return candidates;
  }

  function buildOrthogonalVisibilityGraph(fromPort, toPort, geometry, ownVlans, excludeIds, tracks) {
    const c = CARD_CLEARANCE;
    const margin = 220;
    const region = {
      left: Math.min(fromPort.x, toPort.x) - margin, right: Math.max(fromPort.x, toPort.x) + margin,
      top: Math.min(fromPort.y, toPort.y) - margin, bottom: Math.max(fromPort.y, toPort.y) + margin,
    };
    const relevant = [];
    geometry.nodes.forEach((r, id) => {
      if (excludeIds.has(id)) return;
      if (rectsOverlap(r, region)) relevant.push({ id, r });
    });
    const xs = new Set([fromPort.x, toPort.x]);
    const ys = new Set([fromPort.y, toPort.y]);
    relevant.forEach(({ r }) => { xs.add(r.left - c); xs.add(r.right + c); ys.add(r.top - c); ys.add(r.bottom + c); });
    if (tracks) [tracks.cloudLanY, tracks.lanCoreY, tracks.coreGridY].forEach((y) => { if (y != null) ys.add(y); });
    geometry.zones.forEach((z) => {
      if (rectsOverlap(z, region)) { xs.add(z.left - c); xs.add(z.right + c); ys.add(z.top - c); ys.add(z.bottom + c); }
    });

    const ownerOf = (x, y) => {
      for (const { id, r } of relevant) {
        const onX = Math.abs(x - (r.left - c)) < 0.5 || Math.abs(x - (r.right + c)) < 0.5;
        const onY = Math.abs(y - (r.top - c)) < 0.5 || Math.abs(y - (r.bottom + c)) < 0.5;
        if (onX && onY) return id;
      }
      return null;
    };
    const isBlocked = (x, y) => relevant.some(({ r }) => x > r.left - c && x < r.right + c && y > r.top - c && y < r.bottom + c);

    const vertices = [];
    xs.forEach((x) => ys.forEach((y) => { if (!isBlocked(x, y)) vertices.push({ x, y, owner: ownerOf(x, y) }); }));
    const fromIdx = vertices.findIndex((v) => Math.abs(v.x - fromPort.x) < 0.5 && Math.abs(v.y - fromPort.y) < 0.5);
    const toIdx = vertices.findIndex((v) => Math.abs(v.x - toPort.x) < 0.5 && Math.abs(v.y - toPort.y) < 0.5);

    const edges = [];
    for (let i = 0; i < vertices.length; i++) {
      for (let j = i + 1; j < vertices.length; j++) {
        const vi = vertices[i], vj = vertices[j];
        const localExclude = vi.owner || vj.owner ? new Set([...excludeIds, vi.owner, vj.owner]) : excludeIds;
        if (isSegmentClear(vi, vj, geometry, ownVlans, localExclude)) edges.push([i, j]);
      }
    }
    return { vertices, edges, fromIdx, toIdx };
  }

  function findVisibilityRoute(graphData, fromIdx, toIdx) {
    const { vertices, edges } = graphData;
    const adj = new Map();
    edges.forEach(([i, j]) => {
      if (!adj.has(i)) adj.set(i, []);
      if (!adj.has(j)) adj.set(j, []);
      adj.get(i).push(j); adj.get(j).push(i);
    });
    const stateKey = (idx, dir) => `${idx}|${dir}`;
    const best = new Map([[stateKey(fromIdx, 'none'), 0]]);
    const cameFrom = new Map();
    const queue = [{ idx: fromIdx, dir: 'none', cost: 0 }];
    let goalKey = null;
    while (queue.length) {
      queue.sort((a, b) => a.cost - b.cost);
      const cur = queue.shift();
      const curKey = stateKey(cur.idx, cur.dir);
      if (best.get(curKey) < cur.cost) continue;
      if (cur.idx === toIdx) { goalKey = curKey; break; }
      (adj.get(cur.idx) || []).forEach((nIdx) => {
        const a = vertices[cur.idx], b = vertices[nIdx];
        const dir = Math.abs(a.x - b.x) < 0.5 ? 'v' : 'h';
        const bend = cur.dir !== 'none' && cur.dir !== dir ? 1 : 0;
        const cost = cur.cost + bend * 1e6 + Math.abs(b.x - a.x) + Math.abs(b.y - a.y);
        const nKey = stateKey(nIdx, dir);
        if (!best.has(nKey) || cost < best.get(nKey)) {
          best.set(nKey, cost);
          cameFrom.set(nKey, curKey);
          queue.push({ idx: nIdx, dir, cost });
        }
      });
    }
    if (!goalKey) return null;
    const path = [];
    for (let k = goalKey; k; k = cameFrom.get(k)) path.push(vertices[parseInt(k, 10)]);
    return path.reverse();
  }

  const dirOf = (a, b) => (Math.abs(a.x - b.x) < 0.5 ? 'v' : 'h');
  function countBends(points) {
    let bends = 0;
    for (let i = 1; i < points.length - 1; i++) if (dirOf(points[i - 1], points[i]) !== dirOf(points[i], points[i + 1])) bends++;
    return bends;
  }
  function segmentRelation(a, b, c, d) {
    const abH = a.y === b.y, cdH = c.y === d.y;
    if (abH && cdH) {
      if (Math.abs(a.y - c.y) > 0.5) return { type: 'none' };
      const lo = Math.max(Math.min(a.x, b.x), Math.min(c.x, d.x)), hi = Math.min(Math.max(a.x, b.x), Math.max(c.x, d.x));
      return hi > lo ? { type: 'overlap', length: hi - lo } : { type: 'none' };
    }
    if (!abH && !cdH) {
      if (Math.abs(a.x - c.x) > 0.5) return { type: 'none' };
      const lo = Math.max(Math.min(a.y, b.y), Math.min(c.y, d.y)), hi = Math.min(Math.max(a.y, b.y), Math.max(c.y, d.y));
      return hi > lo ? { type: 'overlap', length: hi - lo } : { type: 'none' };
    }
    const h = abH ? { y: a.y, x1: Math.min(a.x, b.x), x2: Math.max(a.x, b.x) } : { y: c.y, x1: Math.min(c.x, d.x), x2: Math.max(c.x, d.x) };
    const v = abH ? { x: c.x, y1: Math.min(c.y, d.y), y2: Math.max(c.y, d.y) } : { x: a.x, y1: Math.min(a.y, b.y), y2: Math.max(a.y, b.y) };
    return (h.x1 <= v.x && v.x <= h.x2 && v.y1 <= h.y && h.y <= v.y2) ? { type: 'cross' } : { type: 'none' };
  }

  function scoreRouteLexicographically(points, ctx) {
    let hardHits = 0, foreignHits = 0, crossings = 0, overlap = 0, length = 0;
    for (let i = 0; i < points.length - 1; i++) {
      const a = points[i], b = points[i + 1];
      length += Math.abs(b.x - a.x) + Math.abs(b.y - a.y);
      if (segmentHitsCards(a, b, ctx.geometry, ctx.excludeIds)) hardHits++;
      if (segmentHitsForeignVlans(a, b, ctx.geometry, ctx.ownVlans)) foreignHits++;
      ctx.committedSegments.forEach((seg) => {
        const rel = segmentRelation(a, b, seg.a, seg.b);
        if (rel.type === 'cross') crossings++;
        else if (rel.type === 'overlap') overlap += rel.length;
      });
    }
    return { hardHits, foreignHits, bends: countBends(points), crossings, overlap, detourRatio: length / ctx.manhattan, length, points };
  }
  function compareScores(x, y) {
    if (x.hardHits !== y.hardHits) return x.hardHits - y.hardHits;
    if (x.foreignHits !== y.foreignHits) return x.foreignHits - y.foreignHits;
    if (x.bends !== y.bends) return x.bends - y.bends;
    if (x.crossings !== y.crossings) return x.crossings - y.crossings;
    if (x.overlap !== y.overlap) return x.overlap - y.overlap;
    if (Math.abs(x.detourRatio - y.detourRatio) > 1e-3) return x.detourRatio - y.detourRatio;
    return x.length - y.length;
  }

  function simplifyOrthogonalPath(points) {
    if (points.length < 3) return points.slice();
    const out = [points[0]];
    for (let i = 1; i < points.length - 1; i++) {
      const a = out[out.length - 1], b = points[i], c = points[i + 1];
      const collinear = (Math.abs(a.x - b.x) < 0.5 && Math.abs(b.x - c.x) < 0.5) || (Math.abs(a.y - b.y) < 0.5 && Math.abs(b.y - c.y) < 0.5);
      if (!collinear) out.push(b);
    }
    out.push(points[points.length - 1]);
    return out;
  }

  const BORDER_CLEARANCE = 10;
  function nudgeAwayFromBorders(points, borderRects) {
    if (points.length < 4) return points;
    const out = points.map((p) => ({ ...p }));
    for (let i = 1; i < out.length - 2; i++) {
      const a = out[i], b = out[i + 1];
      const horizontal = Math.abs(a.y - b.y) < 0.5;
      for (const r of borderRects) {
        if (horizontal) {
          const lo = Math.min(a.x, b.x), hi = Math.max(a.x, b.x);
          if (hi <= r.left || lo >= r.right) continue;
          for (const borderY of [r.top, r.bottom]) {
            if (Math.abs(a.y - borderY) < BORDER_CLEARANCE) {
              const dir = a.y <= borderY ? -1 : 1;
              a.y = b.y = borderY + dir * BORDER_CLEARANCE;
            }
          }
        } else {
          const lo = Math.min(a.y, b.y), hi = Math.max(a.y, b.y);
          if (hi <= r.top || lo >= r.bottom) continue;
          for (const borderX of [r.left, r.right]) {
            if (Math.abs(a.x - borderX) < BORDER_CLEARANCE) {
              const dir = a.x <= borderX ? -1 : 1;
              a.x = b.x = borderX + dir * BORDER_CLEARANCE;
            }
          }
        }
      }
    }
    return out;
  }

  const CORNER_RADIUS = 8;
  function roundedOrthogonalPath(points) {
    if (points.length < 2) return '';
    if (points.length === 2) return `M${points[0].x},${points[0].y} L${points[1].x},${points[1].y}`;
    let d = `M${points[0].x},${points[0].y}`;
    for (let i = 1; i < points.length - 1; i++) {
      const prev = points[i - 1], cur = points[i], next = points[i + 1];
      const inLen = Math.hypot(cur.x - prev.x, cur.y - prev.y) || 1;
      const outLen = Math.hypot(next.x - cur.x, next.y - cur.y) || 1;
      const r = Math.min(CORNER_RADIUS, inLen / 2, outLen / 2);
      const inX = cur.x + (prev.x - cur.x) * (r / inLen), inY = cur.y + (prev.y - cur.y) * (r / inLen);
      const outX = cur.x + (next.x - cur.x) * (r / outLen), outY = cur.y + (next.y - cur.y) * (r / outLen);
      d += ` L${inX},${inY} Q${cur.x},${cur.y} ${outX},${outY}`;
    }
    const last = points[points.length - 1];
    d += ` L${last.x},${last.y}`;
    return d;
  }

  function busVlanIds() {
    return new Set(VLANS.filter((v) => v.bus).map((v) => v.id));
  }
  function buildRelations(edges) {
    const busVlans = busVlanIds();
    return edges.map((e) => {
      const from = NODE_BY_ID[e.from], to = NODE_BY_ID[e.to];
      const identity = (from.tags || []).includes('opnsense') && (to.tags || []).includes('opnsense');
      const bus = !identity && from.vlan === to.vlan && e.port === '' && busVlans.has(from.vlan);
      return { e, kind: identity ? 'identity' : bus ? 'bus' : 'flow' };
    });
  }

  function groupFlows(relations) {
    const identityEdges = relations.filter((r) => r.kind === 'identity').map((r) => r.e);
    const busByVlan = new Map();
    relations.filter((r) => r.kind === 'bus').forEach((r) => {
      const vlanId = NODE_BY_ID[r.e.from].vlan;
      if (!busByVlan.has(vlanId)) busByVlan.set(vlanId, { kind: 'bus', vlanId, edges: [] });
      busByVlan.get(vlanId).edges.push(r.e);
    });
    const flowByKey = new Map();
    relations.filter((r) => r.kind === 'flow').forEach((r) => {
      const anchorId = selectedIds.has(r.e.from) ? r.e.from : r.e.to;
      const key = `${anchorId}::${r.e.port}::${r.e.label}`;
      if (!flowByKey.has(key)) flowByKey.set(key, { kind: 'flow', anchorId, port: r.e.port, label: r.e.label, edges: [] });
      flowByKey.get(key).edges.push(r.e);
    });
    return {
      identity: identityEdges.length ? [{ kind: 'identity', edges: identityEdges }] : [],
      bus: [...busByVlan.values()],
      flow: [...flowByKey.values()],
    };
  }

  function routeBusRelation(bundle, backboneY, geometry) {
    const nodeIds = new Set();
    bundle.edges.forEach((e) => { nodeIds.add(e.from); nodeIds.add(e.to); });
    const taps = [...nodeIds].map((id) => ({ id, rect: geometry.nodes.get(id) })).filter((t) => t.rect);
    if (!taps.length) return null;
    const excludeIds = new Set(taps.map((t) => t.id));
    const tapLines = taps.map((t) => {
      const dir = t.rect.midY < backboneY ? 1 : -1;
      const startY = dir > 0 ? t.rect.bottom : t.rect.top;
      const lo = Math.min(startY, backboneY), hi = Math.max(startY, backboneY);
      let x = t.rect.midX;
      geometry.nodes.forEach((r, id) => {
        if (excludeIds.has(id)) return;
        if (r.bottom < lo || r.top > hi) return;
        if (x > r.left - CARD_CLEARANCE && x < r.right + CARD_CLEARANCE) x = (t.rect.midX <= (r.left + r.right) / 2) ? r.left - CARD_CLEARANCE : r.right + CARD_CLEARANCE;
      });
      const ownVlan = NODE_BY_ID[t.id].vlan;
      geometry.zones.forEach((r, vlanId) => {
        if (vlanId === ownVlan) return;
        if (r.bottom < lo || r.top > hi) return;
        if (x > r.left && x < r.right) x = (t.rect.midX <= (r.left + r.right) / 2) ? r.left - CARD_CLEARANCE : r.right + CARD_CLEARANCE;
      });
      return { id: t.id, points: [{ x: t.rect.midX, y: startY }, { x, y: startY }, { x, y: backboneY }] };
    });
    const xs = tapLines.map((t) => t.points[t.points.length - 1].x);
    return { backbone: { points: [{ x: Math.min(...xs), y: backboneY }, { x: Math.max(...xs), y: backboneY }] }, taps: tapLines };
  }

  function routeIdentityRelation(bundle, tracks, geometry) {
    return routeBusRelation(bundle, tracks.coreGridY, geometry);
  }

  function routeNormalEdge(e, geometry, tracks, committedSegments) {
    const from = NODE_BY_ID[e.from], to = NODE_BY_ID[e.to];
    const a = geometry.nodes.get(e.from), b = geometry.nodes.get(e.to);
    const excludeIds = new Set([e.from, e.to]);
    const ownVlans = new Set([from.vlan, to.vlan]);
    const manhattan = Math.abs(a.midX - b.midX) + Math.abs(a.midY - b.midY) || 1;
    const ctx = { geometry, ownVlans, excludeIds, committedSegments, manhattan };

    const fromPorts = getCandidatePorts(a), toPorts = getCandidatePorts(b);
    const portPairs = [];
    Object.values(fromPorts).forEach((fp) => Object.values(toPorts).forEach((tp) => portPairs.push([fp, tp])));

    const tryLevel = (build) => {
      const candidates = [];
      portPairs.forEach(([fp, tp]) => candidates.push(...build(fp, tp)));
      return candidates.filter((pts) => pathFullyClear(pts, ctx));
    };

    let valid = tryLevel(makeStraightCandidates);
    if (!valid.length) valid = tryLevel(makeLCandidates);
    if (!valid.length) valid = tryLevel((fp, tp) => makeDoglegCandidates(fp, tp, a, b, tracks, geometry, excludeIds));

    let points;
    if (valid.length) {
      const scored = valid.map((pts) => scoreRouteLexicographically(pts, ctx));
      scored.sort(compareScores);
      points = scored[0].points;
    } else {
      let bestPath = null, bestScore = null;
      portPairs.forEach(([fp, tp]) => {
        const graphData = buildOrthogonalVisibilityGraph(fp, tp, geometry, ownVlans, excludeIds, tracks);
        if (graphData.fromIdx === -1 || graphData.toIdx === -1) return;
        const raw = findVisibilityRoute(graphData, graphData.fromIdx, graphData.toIdx);
        if (!raw) return;
        const scored = scoreRouteLexicographically(raw, ctx);
        if (!bestScore || compareScores(scored, bestScore) < 0) { bestScore = scored; bestPath = raw; }
      });
      if (bestPath) {
        points = bestPath;
      } else {
        const centerA = { x: a.midX, y: a.midY }, centerB = { x: b.midX, y: b.midY };
        const optionA = [centerA, { x: centerB.x, y: centerA.y }, centerB];
        const optionB = [centerA, { x: centerA.x, y: centerB.y }, centerB];
        const clearsCards = (pts) => {
          for (let i = 0; i < pts.length - 1; i++) if (segmentHitsCards(pts[i], pts[i + 1], geometry, excludeIds)) return false;
          return true;
        };
        points = pathFullyClear(optionA, ctx) ? optionA
          : pathFullyClear(optionB, ctx) ? optionB
          : clearsCards(optionA) ? optionA
          : clearsCards(optionB) ? optionB
          : optionA;
      }
    }

    points = nudgeAwayFromBorders(simplifyOrthogonalPath(points), [...geometry.zones.values(), ...geometry.borderBoxes]);
    for (let i = 0; i < points.length - 1; i++) committedSegments.push({ a: points[i], b: points[i + 1] });
    return { points };
  }

  const pulseOn = (pathD, color) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const pts = (pathD.match(/-?[\d.]+,-?[\d.]+/g) || []).map((p) => { const [x, y] = p.split(',').map(Number); return { x, y }; });
      if (!pts.length) return '';
      const lens = [];
      let total = 0;
      for (let i = 1; i < pts.length; i++) { const d = Math.hypot(pts[i].x - pts[i - 1].x, pts[i].y - pts[i - 1].y); lens.push(d); total += d; }
      let acc = 0, mid = pts[0];
      for (let i = 0; i < lens.length; i++) {
        if (acc + lens[i] >= total / 2) { const t = lens[i] ? (total / 2 - acc) / lens[i] : 0; mid = { x: pts[i].x + (pts[i + 1].x - pts[i].x) * t, y: pts[i].y + (pts[i + 1].y - pts[i].y) * t }; break; }
        acc += lens[i];
      }
      return `<circle class="edge-pulse" cx="${mid.x}" cy="${mid.y}" r="2.4" fill="${color}"/>`;
    }
    return `
    <circle class="edge-pulse" r="2.4" fill="${color}">
      <animateMotion dur="${(2.2 + Math.random()).toFixed(1)}s" repeatCount="indefinite" path="${pathD}"/>
    </circle>
  `;
  };
  const reversePath = (d) => 'M' + d.match(/-?[\d.]+,-?[\d.]+/g).reverse().join(' L');
  const labelAt = (x, y, text) => {
    const lw = text.length * 5.2 + 10;
    return `
      <g class="edge-label">
        <rect class="edge-label-bg" x="${x - lw / 2}" y="${y - 8}" width="${lw}" height="16" rx="8"/>
        <text class="edge-label-text" x="${x}" y="${y + 3}" text-anchor="middle">${text}</text>
      </g>
    `;
  };

  function longestSegmentMidpoint(points) {
    let best = null;
    for (let i = 0; i < points.length - 1; i++) {
      const p0 = points[i], p1 = points[i + 1];
      const horizontal = Math.abs(p0.y - p1.y) < 0.5;
      const len = Math.hypot(p1.x - p0.x, p1.y - p0.y) + (horizontal ? 1000 : 0);
      if (!best || len > best.len) best = { len, x: (p0.x + p1.x) / 2, y: (p0.y + p1.y) / 2 };
    }
    return best || { x: points[0].x, y: points[0].y };
  }

  function placeBundleLabels(routedBundles, geometry) {
    const placed = [];
    const cardRects = [...geometry.nodes.values()];
    return routedBundles.map((rb) => {
      if (!rb.labelText) return null;
      const pt = rb.kind === 'flow' ? longestSegmentMidpoint(rb.paths[0].points) : (() => {
        const bb = rb.backbone.points;
        return { x: (bb[0].x + bb[1].x) / 2, y: bb[0].y };
      })();
      const lw = rb.labelText.length * 5.2 + 10;
      const collides = (ly) => placed.some((p) => Math.abs(p.y - ly) < 16 && pt.x - lw / 2 < p.x + p.w / 2 && pt.x + lw / 2 > p.x - p.w / 2)
        || cardRects.some((r) => pt.x - lw / 2 < r.right + 4 && pt.x + lw / 2 > r.left - 4 && ly - 8 < r.bottom + 4 && ly + 8 > r.top - 4);
      let ly = pt.y;
      let guard = 0;
      while (collides(ly) && guard++ < 40) ly += 15;
      placed.push({ x: pt.x, y: ly, w: lw });
      return { x: pt.x, y: ly };
    });
  }

  function drawEdges() {
    const svg = document.getElementById('edges');
    const hubRowEl = document.getElementById('hubRow');
    const visibleEdges = selectedIds.size
      ? EDGES.filter(e => (selectedIds.has(e.from) || selectedIds.has(e.to)) && activeConnKeys.has(edgeKey(e)))
      : [];
    hubRowEl.style.marginBottom = FLOW_GAP + 'px';

    const w = document.getElementById('canvasStack').scrollWidth;
    const h = document.getElementById('canvasStack').scrollHeight;
    svg.setAttribute('width', w);
    svg.setAttribute('height', h);
    svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
    if (!selectedIds.size) { svg.innerHTML = ''; return; }

    const geometry = getGeometry();
    const tracks = buildTracks(geometry);
    const orderedEdges = visibleEdges.slice().sort((x, y) => edgeKey(x).localeCompare(edgeKey(y)));
    const groups = groupFlows(buildRelations(orderedEdges));

    const committedSegments = [];

    const routedBundles = [];
    groups.identity.forEach((bundle) => {
      const routed = routeIdentityRelation(bundle, tracks, geometry);
      if (routed) routedBundles.push({ kind: 'identity', bundle, ...routed, labelText: bundle.edges[0].label });
    });
    groups.bus.forEach((bundle) => {
      const zone = geometry.zones.get(bundle.vlanId);
      const backboneY = zone ? zone.bottom + 20 : (() => {
        const nodeIds = new Set(); bundle.edges.forEach((e) => { nodeIds.add(e.from); nodeIds.add(e.to); });
        const rects = [...nodeIds].map((id) => geometry.nodes.get(id)).filter(Boolean);
        return rects.reduce((s, r) => s + r.bottom, 0) / rects.length + 20;
      })();
      const routed = routeBusRelation(bundle, backboneY, geometry);
      if (routed) routedBundles.push({ kind: 'bus', bundle, ...routed, labelText: bundle.edges[0].label });
    });
    groups.flow.forEach((bundle) => {
      const paths = bundle.edges.map((e) => ({ e, ...routeNormalEdge(e, geometry, tracks, committedSegments) }));
      routedBundles.push({ kind: 'flow', bundle, paths, labelText: bundle.port ? `${bundle.port} · ${bundle.label}` : bundle.label });
    });

    const labelPositions = placeBundleLabels(routedBundles, geometry);

    let html = '';
    routedBundles.forEach((rb, i) => {
      if (rb.kind === 'flow') {
        rb.paths.forEach(({ e, points }) => {
          const from = NODE_BY_ID[e.from], to = NODE_BY_ID[e.to];
          const vlanColor = `var(--vlan-${from.vlan})`;
          const roundedPath = roundedOrthogonalPath(points);
          const sameZone = from.vlan === to.vlan;
          html += `<path class="edge-line" d="${roundedPath}" fill="none" stroke="${vlanColor}" stroke-width="${sameZone ? 1.3 : 1.5}" stroke-opacity="${sameZone ? .6 : .7}" stroke-dasharray="${sameZone ? '3 3' : '4 3'}"/>`;
          html += pulseOn(roundedPath, vlanColor);
        });
      } else {
        const vlanColor = rb.kind === 'bus'
          ? `var(--vlan-${rb.bundle.vlanId})`
          : (() => {
              const openOpnsense = [...selectedIds].find((id) => (NODE_BY_ID[id].tags || []).includes('opnsense'));
              return `var(--vlan-${openOpnsense ? NODE_BY_ID[openOpnsense].vlan : hub.vlan})`;
            })();
        const backboneD = roundedOrthogonalPath(rb.backbone.points);
        const straightBackbone = rb.backbone.points.map((p, idx) => `${idx === 0 ? 'M' : 'L'}${p.x},${p.y}`).join(' ');
        html += `<path class="edge-line" d="${backboneD}" fill="none" stroke="${vlanColor}" stroke-width="1.5" stroke-opacity=".7" stroke-dasharray="4 3"/>`;
        rb.taps.forEach((t) => {
          const tapD = roundedOrthogonalPath(t.points);
          html += `<path class="edge-line" d="${tapD}" fill="none" stroke="${vlanColor}" stroke-width="1.3" stroke-opacity=".6" stroke-dasharray="3 3"/>`;
        });
        const openTap = rb.taps.find((t) => selectedIds.has(t.id));
        const backboneMidX = (rb.backbone.points[0].x + rb.backbone.points[1].x) / 2;
        const reverse = openTap && openTap.points[openTap.points.length - 1].x > backboneMidX;
        html += pulseOn(reverse ? reversePath(straightBackbone) : straightBackbone, vlanColor);
      }

      const label = labelPositions[i];
      if (label) html += labelAt(label.x, label.y, rb.labelText);
    });
    svg.innerHTML = html;
  }

  const panel = document.getElementById('panel');

  function renderPanel() {
    if (selectedIds.size === 0) { closePanel(); return; }

    if (selectedIds.size === 1) {
      const node = NODE_BY_ID[[...selectedIds][0]];
      const vlan = VLAN_BY_ID[node.vlan];
      document.getElementById('panelIcon').innerHTML = ICONS[node.icon] || ICONS.box;
      document.getElementById('panelIcon').style.background = `var(--vlan-${node.vlan}-bg)`;
      document.getElementById('panelIcon').style.color = `var(--vlan-${node.vlan})`;
      document.getElementById('panelName').textContent = node.name;
      const vlanTag = document.getElementById('panelVlan');
      vlanTag.textContent = `${vlan.name} · ${node.ip}`;
      vlanTag.style.color = `var(--vlan-${node.vlan})`;
      document.getElementById('panelDesc').style.display = 'block';
      document.getElementById('panelDesc').innerHTML = linkifyDesc(node.desc, node.id);

      const hwSource = Object.keys(node.hardware || {}).length ? node.hardware
        : (node.tags || []).includes('opnsense') ? (NODE_BY_ID['opnsense'].hardware || {}) : {};
      const hwEntries = Object.entries(hwSource);
      const hwLabel = { ram: 'RAM', cpu: 'CPU', disk: 'Disk' };
      document.getElementById('kvSection').style.display = hwEntries.length ? 'block' : 'none';
      document.getElementById('panelKv').innerHTML = hwEntries.map(([k, v]) => `
        <dt>${hwLabel[k] || k}</dt><dd>${v}</dd>
      `).join('');

      document.getElementById('portsSection').style.display = 'block';
      const portsEl = document.getElementById('panelPorts');
      portsEl.innerHTML = node.ports.length
        ? node.ports.map(p => `<div class="port-row"><span class="port-num">${p.port}</span><span class="port-label">${p.label}</span></div>`).join('')
        : `<p style="font-size:.72rem;color:var(--muted);margin:0;">No known services</p>`;

      document.getElementById('devicesSection').style.display = 'none';

      const outgoing = EDGES.filter(e => e.from === node.id);
      const incoming = EDGES.filter(e => e.to === node.id);
      const allConns = [
        ...buildRelations(outgoing).map(({ e, kind }) => ({ dir: '→', other: NODE_BY_ID[e.to].name, otherVlan: NODE_BY_ID[e.to].vlan, port: e.port, label: e.label, key: edgeKey(e), kind })),
        ...buildRelations(incoming).map(({ e, kind }) => ({ dir: isMesh(e) ? '→' : '←', other: NODE_BY_ID[e.from].name, otherVlan: NODE_BY_ID[e.from].vlan, port: e.port, label: e.label, key: edgeKey(e), kind })),
      ];
      activeConnKeys = new Set(allConns.map(c => c.key));
      renderConns(allConns);

      history.replaceState(null, '', '#device=' + node.id);
    } else {
      const nodes = [...selectedIds].map(id => NODE_BY_ID[id]);
      const vlans = new Set(nodes.map(n => n.vlan));
      const singleVlan = vlans.size === 1 ? VLAN_BY_ID[[...vlans][0]] : null;

      document.getElementById('panelIcon').innerHTML = ICONS.layers;
      document.getElementById('panelIcon').style.background = singleVlan ? `var(--vlan-${singleVlan.id}-bg)` : 'var(--surface-2)';
      document.getElementById('panelIcon').style.color = singleVlan ? `var(--vlan-${singleVlan.id})` : 'var(--muted)';
      document.getElementById('panelName').textContent = `${nodes.length} devices selected`;
      const vlanTag = document.getElementById('panelVlan');
      vlanTag.textContent = singleVlan ? singleVlan.name : 'Multi-VLAN';
      vlanTag.style.color = singleVlan ? `var(--vlan-${singleVlan.id})` : 'var(--muted)';
      document.getElementById('panelDesc').style.display = 'none';
      document.getElementById('kvSection').style.display = 'none';
      document.getElementById('portsSection').style.display = 'none';

      document.getElementById('devicesSection').style.display = 'block';
      document.getElementById('panelDevices').innerHTML = nodes.map(n => `
        <div class="port-row">
          <span class="node-icon" style="width:20px;height:20px;background:var(--vlan-${n.vlan}-bg);color:var(--vlan-${n.vlan})">${ICONS[n.icon] || ICONS.box}</span>
          <span>${n.name}</span>
          <span class="port-label" style="margin-left:auto">${n.ip}</span>
        </div>
      `).join('');

      const seen = new Set();
      const relevantEdges = EDGES.filter(e => {
        if (!selectedIds.has(e.from) && !selectedIds.has(e.to)) return false;
        const key = edgeKey(e);
        if (seen.has(key)) return false;
        seen.add(key);
        return true;
      });
      const allConns = buildRelations(relevantEdges).map(({ e, kind }) => ({
        dir: `${NODE_BY_ID[e.from].name} →`, other: NODE_BY_ID[e.to].name, otherVlan: NODE_BY_ID[e.to].vlan,
        port: e.port, label: e.label, key: edgeKey(e), kind,
      }));
      activeConnKeys = new Set(allConns.map(c => c.key));
      renderConns(allConns);
      history.replaceState(null, '', location.pathname + location.search);
    }

    panel.classList.add('open');
    document.querySelectorAll('.node-card').forEach(c => {
      const isSelected = selectedIds.has(c.dataset.id);
      const isRelated = !isSelected && EDGES.some(e =>
        (selectedIds.has(e.from) && e.to === c.dataset.id) || (selectedIds.has(e.to) && e.from === c.dataset.id));
      c.classList.toggle('focused', isSelected);
      c.classList.toggle('related', isRelated);
      c.classList.toggle('dimmed', !isSelected && !isRelated);
    });
    drawEdges();
  }

  function renderConns(allConns) {
    const connHeader = document.getElementById('connHeader');
    const connToggleAll = document.getElementById('connToggleAll');
    const connsEl = document.getElementById('panelConns');
    if (allConns.length) {
      connHeader.style.display = 'flex';

      const connRowHtml = (c) => `
        <label class="conn-row">
          <input type="checkbox" class="conn-check" data-key="${c.key}" checked />
          <span class="conn-row-text">
            <span class="conn-row-main">
              <span class="conn-arrow">${c.dir}</span> <span style="color:var(--vlan-${c.otherVlan})">${c.other}</span>
              ${c.port ? `<span class="conn-port">${c.port}</span>` : ''}
            </span>
            ${c.label ? `<span class="conn-label">${c.label}</span>` : ''}
          </span>
        </label>
      `;

      const groups = new Map();
      const flat = [];
      allConns.forEach((c) => {
        if (c.kind !== 'identity') { flat.push(c); return; }
        if (!groups.has('identity')) groups.set('identity', { label: c.label, items: [] });
        groups.get('identity').items.push(c);
      });

      const groupHtml = ([groupKey, group]) => `
        <div class="conn-group">
          <button type="button" class="conn-group-header" data-group="${groupKey}">
            <svg class="conn-group-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            <span>${group.label} (${group.items.length})</span>
          </button>
          <div class="conn-group-list" data-group-list="${groupKey}">
            ${group.items.map(connRowHtml).join('')}
          </div>
        </div>
      `;

      connsEl.innerHTML = [...groups.entries()].map(groupHtml).join('') + flat.map(connRowHtml).join('');

      connsEl.querySelectorAll('.conn-group-header').forEach((btn) => {
        btn.addEventListener('click', () => {
          const list = connsEl.querySelector(`[data-group-list="${btn.dataset.group}"]`);
          const collapsed = list.classList.toggle('collapsed');
          btn.classList.toggle('collapsed', collapsed);
        });
      });

      connToggleAll.textContent = 'Hide all';
      connsEl.querySelectorAll('.conn-check').forEach(cb => {
        cb.addEventListener('change', () => {
          const key = cb.dataset.key;
          cb.closest('.conn-row').classList.toggle('off', !cb.checked);
          if (cb.checked) activeConnKeys.add(key); else activeConnKeys.delete(key);
          connToggleAll.textContent = activeConnKeys.size ? 'Hide all' : 'Show all';
          drawEdges();
        });
      });
      connToggleAll.onclick = () => {
        const turningOn = connToggleAll.textContent === 'Show all';
        connsEl.querySelectorAll('.conn-check').forEach(cb => {
          cb.checked = turningOn;
          cb.closest('.conn-row').classList.toggle('off', !turningOn);
          if (turningOn) activeConnKeys.add(cb.dataset.key); else activeConnKeys.delete(cb.dataset.key);
        });
        connToggleAll.textContent = turningOn ? 'Hide all' : 'Show all';
        drawEdges();
      };
    } else {
      connHeader.style.display = 'none';
      connsEl.innerHTML = '';
    }
  }

  function closePanel() {
    document.querySelectorAll('.legend-item.active').forEach(el => el.classList.remove('active'));
    activeVlanIds = new Set();
    panel.classList.remove('open');
    document.querySelectorAll('.node-card').forEach(c => c.classList.remove('focused', 'related', 'dimmed'));
    selectedIds = new Set();
    drawEdges();
    history.replaceState(null, '', location.pathname + location.search);
  }

  function setSelection(ids) {
    clearFilter();
    selectedIds = new Set(ids);
    if (selectedIds.size === 0) { closePanel(); return; }
    renderPanel();
  }

  function toggleInSelection(id) {
    clearFilter();
    const next = new Set(selectedIds);
    next.has(id) ? next.delete(id) : next.add(id);
    selectedIds = next;
    if (selectedIds.size === 0) { closePanel(); return; }
    renderPanel();
  }

  const searchInput = document.getElementById('search-input');

  function clearFilter() {
    searchInput.value = '';
    document.querySelectorAll('.legend-item.active').forEach(el => el.classList.remove('active'));
    activeVlanIds = new Set();
    document.getElementById('search-results').classList.remove('open');
  }

  function applyFilter(matchIds) {
    if (selectedIds.size) closePanel();
    document.querySelectorAll('.node-card').forEach(c => {
      const match = matchIds.has(c.dataset.id);
      c.classList.toggle('related', match);
      c.classList.toggle('dimmed', !match);
    });
  }

  const searchResults = document.getElementById('search-results');
  let searchActiveIndex = -1;

  function highlightSearchResult(index) {
    const items = [...searchResults.querySelectorAll('.search-result-item')];
    items.forEach((el, i) => el.classList.toggle('highlighted', i === index));
    if (items[index]) items[index].scrollIntoView({ block: 'nearest' });
  }

  function renderSearchResults(matches) {
    searchActiveIndex = -1;
    if (!matches.length) {
      searchResults.innerHTML = `<div class="search-empty">No device found</div>`;
    } else {
      searchResults.innerHTML = matches.map(n => `
        <button class="search-result-item" data-id="${n.id}">
          <span class="node-icon" style="background:var(--vlan-${n.vlan}-bg);color:var(--vlan-${n.vlan})">${ICONS[n.icon] || ICONS.box}</span>
          <span>
            <span class="search-result-name">${n.name}</span><br/>
            <span class="search-result-ip">${n.ip}</span>
          </span>
        </button>
      `).join('');
      searchResults.querySelectorAll('.search-result-item').forEach(btn => {
        btn.addEventListener('click', () => setSelection([btn.dataset.id]));
      });
    }
    searchResults.classList.add('open');
  }

  searchInput.addEventListener('keydown', (e) => {
    if (!searchResults.classList.contains('open')) return;
    const items = searchResults.querySelectorAll('.search-result-item');
    if (!items.length) return;
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      searchActiveIndex = (searchActiveIndex + 1) % items.length;
      highlightSearchResult(searchActiveIndex);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      searchActiveIndex = (searchActiveIndex - 1 + items.length) % items.length;
      highlightSearchResult(searchActiveIndex);
    } else if (e.key === 'Enter' && searchActiveIndex >= 0) {
      e.preventDefault();
      setSelection([items[searchActiveIndex].dataset.id]);
    }
  });

  searchInput.addEventListener('input', (e) => {
    document.querySelectorAll('.legend-item.active').forEach(el => el.classList.remove('active'));
    activeVlanIds = new Set();
    const q = e.target.value.trim().toLowerCase();
    if (!q) {
      document.querySelectorAll('.node-card').forEach(c => c.classList.remove('related', 'dimmed'));
      searchResults.classList.remove('open');
      return;
    }
    const matches = NODES.filter(n => n.name.toLowerCase().includes(q) || n.ip.includes(q));
    applyFilter(new Set(matches.map(n => n.id)));
    renderSearchResults(matches);
  });
  searchInput.addEventListener('focus', () => { if (searchInput.value.trim()) searchResults.classList.add('open'); });
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.search-wrap')) searchResults.classList.remove('open');
  });

  document.querySelectorAll('.legend-item').forEach(el => {
    el.addEventListener('click', (e) => {
      searchInput.value = '';
      const wasActive = el.classList.contains('active');
      const vlanId = el.dataset.vlan;
      const vlanIds = NODES.filter(n => n.vlan === vlanId).map(n => n.id);

      let nextVlanIds, nextIds;
      if (e.ctrlKey || e.metaKey) {
        nextVlanIds = new Set(activeVlanIds);
        wasActive ? nextVlanIds.delete(vlanId) : nextVlanIds.add(vlanId);
        nextIds = wasActive
          ? [...selectedIds].filter((id) => !vlanIds.includes(id))
          : [...selectedIds, ...vlanIds];
      } else {
        nextVlanIds = wasActive ? new Set() : new Set([vlanId]);
        nextIds = wasActive ? [] : vlanIds;
      }

      setSelection(nextIds);
      activeVlanIds = nextVlanIds;
      document.querySelectorAll('.legend-item').forEach(x => x.classList.toggle('active', activeVlanIds.has(x.dataset.vlan)));
    });
  });

  document.querySelectorAll('.node-card').forEach(card => {
    card.addEventListener('click', (e) => {
      const id = card.dataset.id;
      if (e.ctrlKey || e.metaKey) { toggleInSelection(id); return; }
      if (selectedIds.size === 1 && selectedIds.has(id)) { closePanel(); return; }
      setSelection([id]);
    });
  });
  document.getElementById('panelClose').addEventListener('click', closePanel);
  document.getElementById('panelDesc').addEventListener('click', (e) => {
    const link = e.target.closest('.desc-link');
    if (link && NODE_BY_ID[link.dataset.id]) setSelection([link.dataset.id]);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === '/') {
      const active = document.activeElement;
      const isTyping = active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA' || active.isContentEditable);
      if (isTyping) return;
      e.preventDefault();
      searchInput.focus();
      searchInput.select();
      return;
    }
    if (e.key === 'Escape' && document.getElementById('help-dropdown').classList.contains('open')) {
      document.getElementById('help-dropdown').classList.remove('open');
      document.getElementById('help-btn').setAttribute('aria-expanded', 'false');
      return;
    }
    if (e.key === 'Escape' && document.activeElement === searchInput) {
      searchInput.blur();
      document.getElementById('search-results').classList.remove('open');
      return;
    }
    if (e.key === 'Escape' && selectedIds.size) { closePanel(); return; }
  });

  if (location.hash.startsWith('#device=')) {
    const wanted = decodeURIComponent(location.hash.slice(8));
    if (NODE_BY_ID[wanted]) setSelection([wanted]);
  }

  document.fonts.ready.then(() => {
    drawEdges();
    fitToView();
    drawEdges();
  });
  window.addEventListener('resize', () => drawEdges());

  </script>


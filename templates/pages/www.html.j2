        'z': { w: 4, rows: ['0000', '0000', '1111', '0010', '0100', '1000', '1111', '0000', '0000'] },
        '0': { w: 5, rows: ['01110', '10001', '10011', '10101', '11001', '10001', '01110', Z(5), Z(5)] },
        '1': { w: 5, rows: ['00100', '01100', '00100', '00100', '00100', '00100', '01110', Z(5), Z(5)] },
        '2': { w: 5, rows: ['01110', '10001', '00001', '00010', '00100', '01000', '11111', Z(5), Z(5)] },
        '3': { w: 5, rows: ['11111', '00010', '00100', '00010', '00001', '10001', '01110', Z(5), Z(5)] },
        '4': { w: 5, rows: ['00010', '00110', '01010', '10010', '11111', '00010', '00010', Z(5), Z(5)] },
        '5': { w: 5, rows: ['11111', '10000', '11110', '00001', '00001', '10001', '01110', Z(5), Z(5)] },
        '6': { w: 5, rows: ['00110', '01000', '10000', '11110', '10001', '10001', '01110', Z(5), Z(5)] },
        '7': { w: 5, rows: ['11111', '00001', '00010', '00100', '01000', '01000', '01000', Z(5), Z(5)] },
        '8': { w: 5, rows: ['01110', '10001', '10001', '01110', '10001', '10001', '01110', Z(5), Z(5)] },
        '9': { w: 5, rows: ['01110', '10001', '10001', '01111', '00001', '00010', '01100', Z(5), Z(5)] },
        '?': { w: 5, rows: ['01110', '10001', '00001', '00010', '00100', Z(5), '00100', Z(5), Z(5)] },
        '!': { w: 2, rows: ['10', '10', '10', '10', '10', Z(2), '10', Z(2), Z(2)] },
        '-': { w: 4, rows: [Z(4), Z(4), Z(4), Z(4), '1111', Z(4), Z(4), Z(4), Z(4)] },
        "'": { w: 2, rows: ['10', '10', Z(2), Z(2), Z(2), Z(2), Z(2), Z(2), Z(2)] },
        '.': { w: 2, rows: [Z(2), Z(2), Z(2), Z(2), Z(2), Z(2), '10', Z(2), Z(2)] },
        ',': { w: 2, rows: [Z(2), Z(2), Z(2), Z(2), Z(2), '10', '01', Z(2), Z(2)] },
      };

      function glyphFor(ch) {
        return FONT[ch.toLowerCase()] || FONT[' '];
      }

      function textToStrip(text) {
        const glyphs = Array.from(text || ' ').map(glyphFor);
        const textW = Math.max(glyphs.reduce((sum, g) => sum + g.w + 1, 0) - 1, 1);
        // gap before the text loops when scrolling, the real bar uses 2 spaces here
        const LOOP_GAP = (FONT[' '].w + 1) * 1;
        const stripW = textW > COLS ? textW + LOOP_GAP : COLS;
        const buf = new Uint8Array(stripW * FONT_H);
        let cx = 0;
        glyphs.forEach((g) => {
          for (let y = 0; y < FONT_H; y++) {
            const row = g.rows[y];
            for (let x = 0; x < g.w; x++) {
              if (row[x] === '1') buf[y * stripW + cx + x] = 1;
            }
          }
          cx += g.w + 1;
        });
        return { buf, stripW, textW };
      }

      function sampleTextWindow(strip, offsetX) {
        const out = new Float32Array(COLS * ROWS);
        const ox = Math.floor(offsetX);
        for (let y = 0; y < FONT_H; y++) {
          const screenY = y + TEXT_Y;
          if (screenY >= ROWS) break;
          for (let x = 0; x < COLS; x++) {
            const srcX = (ox + x) % strip.stripW;
            out[screenY * COLS + x] = strip.buf[y * strip.stripW + srcX];
          }
        }
        return out;
      }

      let stripData = null, stripW = 0, needsScroll = false, offset = 0;
      let selectedColor = '#FFFFFF';

      function colorPillBackground(hex) {
        const r = parseInt(hex.slice(1, 3), 16);
        const g = parseInt(hex.slice(3, 5), 16);
        const b = parseInt(hex.slice(5, 7), 16);
        return `rgba(${r}, ${g}, ${b}, .3)`;
      }

      function drawBuffer(buf) {
        // real LED pixels are hard on/off, no anti-aliasing
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        const cell = canvas.width / COLS;
        ctx.fillStyle = selectedColor;
        const gap = Math.max(1, cell * 0.12);
        for (let y = 0; y < ROWS; y++) {
          for (let x = 0; x < COLS; x++) {
            if (buf[y * COLS + x] < 0.5) continue;
            ctx.fillRect(x * cell + gap, y * cell + gap, cell - gap * 2, cell - gap * 2);
          }
        }
      }

      function setText(text) {
        const strip = textToStrip(text || ' ');
        stripData = strip; stripW = strip.stripW; needsScroll = strip.textW > COLS; offset = 0;
        if (!needsScroll) drawBuffer(sampleTextWindow(strip, 0));
      }

      function tick() {
        if (needsScroll && stripData) {
          offset = (offset + 0.15) % stripData.stripW;
          drawBuffer(sampleTextWindow(stripData, offset));
        }
        requestAnimationFrame(tick);
      }

      function updateCounter() {
        const len = textarea.value.length;
        counter.textContent = `${len}/60`;
        counter.classList.toggle('warn', len > 50);
      }

      textarea.addEventListener('input', () => { updateCounter(); setText(textarea.value); });

      let mode = 'text';
      let imageFile = null;
      let loadedImage = null;
      const textField = document.getElementById('wall-text-field');
      const imageField = document.getElementById('wall-image-field');
      const dropZone = document.getElementById('wall-drop-zone');
      const fileInput = document.getElementById('wall-file-input');

      function imageToBuffer(img) {
        const tmp = document.createElement('canvas');
        tmp.width = COLS; tmp.height = ROWS;
        const tctx = tmp.getContext('2d');
        const scale = Math.min(COLS / img.width, ROWS / img.height);
        const dw = img.width * scale, dh = img.height * scale;
        tctx.drawImage(img, (COLS - dw) / 2, (ROWS - dh) / 2, dw, dh);
        return tctx.getImageData(0, 0, COLS, ROWS).data; // RGBA, the bar's screen is color
      }

      function drawImageBuffer(data) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        const cell = canvas.width / COLS;
        for (let y = 0; y < ROWS; y++) {
          for (let x = 0; x < COLS; x++) {
            const i = (y * COLS + x) * 4;
            const a = data[i + 3] / 255;
            if (a < 0.05) continue;
            ctx.globalAlpha = a;
            ctx.fillStyle = `rgb(${data[i]}, ${data[i + 1]}, ${data[i + 2]})`;
            ctx.beginPath();
            ctx.arc(x * cell + cell / 2, y * cell + cell / 2, cell * 0.32, 0, Math.PI * 2);
            ctx.fill();
          }
        }
        ctx.globalAlpha = 1;
      }

      const colorPicker = document.getElementById('wall-color-picker');
      const colorTrigger = document.getElementById('wall-color-trigger');
      const colorPopover = document.getElementById('wall-color-popover');

      document.querySelectorAll('.wall-mode-toggle button').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.wall-mode-toggle button').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          mode = btn.dataset.mode;
          textField.style.display = mode === 'text' ? '' : 'none';
          imageField.style.display = mode === 'image' ? '' : 'none';
          colorPicker.style.display = mode === 'text' ? '' : 'none';
          needsScroll = false;
          if (mode === 'text') {
            setText(textarea.value);
          } else if (loadedImage) {
            drawImageBuffer(imageToBuffer(loadedImage));
          } else {
            drawImageBuffer(new Uint8ClampedArray(COLS * ROWS * 4));
          }
        });
      });

      colorTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = colorPopover.classList.toggle('open');
        colorTrigger.setAttribute('aria-expanded', String(isOpen));
      });

      document.querySelectorAll('.wall-color-swatch').forEach((sw) => {
        sw.addEventListener('click', () => {
          document.querySelectorAll('.wall-color-swatch').forEach((s) => s.classList.remove('active'));
          sw.classList.add('active');
          selectedColor = sw.dataset.color;
          colorTrigger.style.background = colorPillBackground(selectedColor);
          colorPopover.classList.remove('open');
          colorTrigger.setAttribute('aria-expanded', 'false');
          if (mode === 'text' && stripData) drawBuffer(sampleTextWindow(stripData, offset));
        });
      });

      document.addEventListener('click', (e) => {
        if (colorPopover.classList.contains('open') && !colorPopover.contains(e.target) && e.target !== colorTrigger) {
          colorPopover.classList.remove('open');
          colorTrigger.setAttribute('aria-expanded', 'false');
        }
      });

      dropZone.addEventListener('click', () => fileInput.click());
      dropZone.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') fileInput.click(); });
      fileInput.addEventListener('change', () => {
        const file = fileInput.files[0];
        if (!file) return;
        imageFile = file;
        const img = new Image();
        img.onload = () => {
          loadedImage = img;
          drawImageBuffer(imageToBuffer(img));
        };
        img.src = URL.createObjectURL(file);
      });

      const API_URL = '{{ api_base_url }}';

      function reportResult(res) {
        if (res.ok) {
          toast.textContent = t('wall.sent');
          return 30;
        }
        toast.textContent = res.status === 429 ? t('wall.rateLimited') : t('wall.error');
        toast.classList.add('error');
        if (res.status === 429) {
          const retryAfter = parseInt(res.headers.get('Retry-After'), 10);
          if (Number.isFinite(retryAfter) && retryAfter > 0) return retryAfter;
        }
        return 30;
      }

      const sendLabel = sendBtn.textContent;
      const COOLDOWN_KEY = 'wallCooldownUntil';

      function persistCooldown(waitSecs) {
        try { localStorage.setItem(COOLDOWN_KEY, String(Date.now() + waitSecs * 1000)); } catch { /* storage unavailable */ }
      }

      function startCooldown(initialSecs) {
        let secs = initialSecs || 30;
        cooling = true;
        sendBtn.disabled = true;
        sendBtn.textContent = `${secs}s`;
        const iv = setInterval(() => {
          secs -= 1;
          if (secs <= 0) {
            clearInterval(iv);
            cooling = false;
            sendBtn.disabled = false;
            sendBtn.textContent = sendLabel;
            toast.classList.remove('show');
            try { localStorage.removeItem(COOLDOWN_KEY); } catch { /* storage unavailable */ }
          } else {
            sendBtn.textContent = `${secs}s`;
          }
        }, 1000);
      }

      let cooling = false;

      // persist the cooldown so a refresh mid-wait doesn't show a clickable Send again
      (function restoreCooldown() {
        let until = 0;
        try { until = parseInt(localStorage.getItem(COOLDOWN_KEY), 10) || 0; } catch { /* storage unavailable */ }
        const remaining = Math.ceil((until - Date.now()) / 1000);
        if (remaining > 0) startCooldown(remaining);
      })();
      sendBtn.addEventListener('click', async () => {
        if (cooling) return;
        if (mode === 'text') {
          const message = textarea.value.trim();
          if (!message) return;
          cooling = true;
          sendBtn.disabled = true;
          toast.classList.remove('error');
          toast.textContent = t('wall.sending');
          toast.classList.add('show');
          let waitSecs = 30;
          try {
            const res = await fetch(`${API_URL}/wall/message`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ message, color: selectedColor }),
            });
            waitSecs = reportResult(res);
          } catch {
            toast.textContent = t('wall.error');
            toast.classList.add('error');
          }
          persistCooldown(waitSecs);
          startCooldown(waitSecs);
        } else {
          if (!imageFile) return;
          cooling = true;
          sendBtn.disabled = true;
          toast.classList.remove('error');
          toast.textContent = t('wall.sending');
          toast.classList.add('show');
          let waitSecs = 30;
          try {
            const form = new FormData();
            form.append('file', imageFile);
            const res = await fetch(`${API_URL}/wall/image`, { method: 'POST', body: form });
            waitSecs = reportResult(res);
          } catch {
            toast.textContent = t('wall.error');
            toast.classList.add('error');
          }
          persistCooldown(waitSecs);
          startCooldown(waitSecs);
        }
      });

      updateCounter();
      setText(textarea.value);
      tick();
    })();
  </script>
</body>
</html>

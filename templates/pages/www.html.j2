{% from "partials/js_str.j2" import js_str %}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script>
{% include "partials/theme_toggle.js.j2" %}
  </script>
  <title>{{ i18n['title.home'] }}</title>
  <meta name="description" content="{{ meta_description }}" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="{{ og_url }}" />
  <meta property="og:title" content="khaddict" />
  <meta property="og:description" content="{{ meta_description }}" />
  <meta property="og:image" content="{{ brand_icon_src }}" />
  <meta property="og:locale" content="{{ og_locale }}" />
  <meta property="og:locale:alternate" content="{{ og_locale_alternate }}" />
  <link rel="canonical" href="{{ canonical_url }}" />
  <link rel="alternate" hreflang="en" href="{{ hreflang_en_href }}" />
  <link rel="alternate" hreflang="fr" href="{{ hreflang_fr_href }}" />
  <link rel="alternate" hreflang="x-default" href="{{ hreflang_x_default_href }}" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="khaddict" />
  <meta name="twitter:image" content="{{ brand_icon_src }}" />
  <link rel="icon" href="{{ brand_icon_src }}" type="image/png" />
  <link rel="apple-touch-icon" href="{{ brand_icon_src }}" />

{% include "partials/matomo.html.j2" %}

  <style>
{% include "partials/head_tokens.css.j2" %}
{% include "partials/status_widget.css.j2" %}
    .hero {
      flex: 1;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 1.25rem 1.5rem;
      animation: fade-up .45s ease both;
    }

    .hero-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 3rem;
      max-width: max(1400px, 70vw);
      width: 100%;
    }

    .hero-copy { flex: 0 1 max(500px, 35vw); text-align: left; }

    .hero h1 {
      font-size: clamp(1.5rem, 4vw, 2.4rem);
      font-weight: 700;
      line-height: 1.4;
      max-width: max(500px, 35vw);
      letter-spacing: -.02em;
    }

    @media (max-width: 940px) {
      .hero-row { flex-direction: column; text-align: center; gap: 2rem; }
      .hero-copy { flex: none; text-align: center; max-width: 100%; }
      .hero h1 { max-width: 100%; margin: 0 auto; }
    }

    .hero .highlight {
      background: linear-gradient(90deg, var(--accent), var(--accent-2));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .repo-link {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      margin-top: .9rem;
      font-family: 'JetBrains Mono', monospace;
      font-size: .8rem;
      color: var(--muted);
      text-decoration: none;
      transition: color .15s ease;
    }
    .repo-link:hover { color: var(--accent); }
    .repo-link svg { width: 14px; height: 14px; }

    @keyframes fade-up {
      from { opacity: 0; transform: translateY(10px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .wall-card {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: .6rem;
      padding: 1.1rem 1.5rem;
      border-radius: 16px;
      background: var(--surface);
      border: 1px solid var(--border);
      box-shadow: 0 20px 50px var(--shadow);
      flex: 1 1 520px;
      max-width: max(650px, 45vw);
      width: 100%;
      transition: background-color .2s ease, border-color .2s ease;
    }

    .wall-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .wall-head-left {
      display: flex;
      align-items: center;
      gap: .55rem;
      flex-wrap: wrap;
    }

    .wall-eyebrow {
      font-size: .68rem;
      font-weight: 600;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: #8457e9;
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) .wall-eyebrow { color: var(--accent); }
    }
    :root[data-theme="dark"] .wall-eyebrow { color: var(--accent); }

    .wall-messages-counter {
      font-size: .68rem;
      color: var(--muted);
    }

    .wall-messages-counter::before {
      content: "·";
      margin-right: .55rem;
    }

    .wall-live-pill {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      font-size: .7rem;
      font-weight: 600;
      color: var(--text);
      background: var(--up-bg);
      transition: background .3s ease;
      padding: .28rem .6rem .28rem .5rem;
      border-radius: 999px;
      flex-shrink: 0;
      white-space: nowrap;
    }

    .wall-live-pill.down { background: var(--down-bg); }
    .wall-live-pill.warn { background: var(--warn-bg); }

    .wall-card h2 {
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: -.01em;
      margin: -.4rem 0 0;
    }

    .wall-scene {
      position: relative;
      width: 100%;
      aspect-ratio: 1672 / 941;
      border-radius: 8px;
      overflow: hidden;
      background-image: url('{{ wall_scene_src }}');
      background-size: cover;
      background-position: center;
    }

    .wall-scene canvas {
      position: absolute;
      left: 26.08%;
      top: 59.72%;
      width: 15.67%;
      height: 6.16%;
      display: block;
      image-rendering: pixelated;
    }

    .wall-port-led {
      position: absolute;
      width: 1.6%;
      height: .75%;
      border-radius: 50%;
      background: radial-gradient(ellipse at center, rgba(70, 255, 140, 1) 0%, rgba(70, 255, 140, .55) 45%, rgba(70, 255, 140, 0) 80%);
      transform: translate(-50%, -50%);
      mix-blend-mode: screen;
      animation: port-led-flicker 2.4s ease-in-out infinite;
      pointer-events: none;
    }

    .wall-port-led.amber {
      background: radial-gradient(ellipse at center, rgba(255, 190, 60, 1) 0%, rgba(255, 190, 60, .55) 45%, rgba(255, 190, 60, 0) 80%);
    }

    .wall-port-led.round {
      width: .9%;
      height: .9%;
    }

    .wall-port-led.blue {
      background: radial-gradient(ellipse at center, rgba(70, 150, 255, 1) 0%, rgba(70, 150, 255, .55) 45%, rgba(70, 150, 255, 0) 80%);
    }

    @keyframes port-led-flicker {
      0%, 100% { opacity: .8; }
      4% { opacity: .25; }
      7% { opacity: .9; }
      10% { opacity: .3; }
      14% { opacity: 1; }
      45% { opacity: .8; }
      60% { opacity: .3; }
      64% { opacity: 1; }
      90% { opacity: .8; }
    }

    .wall-crystal-aura {
      position: absolute;
      left: 93.99%;
      top: 7%;
      width: 7%;
      height: 14%;
      transform: translate(-50%, -50%);
      border-radius: 50%;
      background: radial-gradient(circle, rgba(140, 110, 255, .55) 0%, rgba(110, 80, 255, .25) 40%, rgba(110, 80, 255, 0) 70%);
      animation: crystal-aura-pulse 4s ease-in-out infinite;
      pointer-events: none;
      mix-blend-mode: screen;
    }

    .wall-keyboard-glow {
      position: absolute;
      left: 47.55%;
      top: 95.11%;
      width: 33%;
      height: 1.3%;
      transform: translate(-50%, -50%);
      border-radius: 50%;
      background: radial-gradient(ellipse at center, rgba(160, 60, 255, .75) 0%, rgba(140, 50, 255, .35) 40%, rgba(140, 50, 255, 0) 65%);
      animation: crystal-aura-pulse 3.6s ease-in-out infinite;
      pointer-events: none;
      mix-blend-mode: screen;
    }

    @keyframes crystal-aura-pulse {
      0%, 100% { opacity: .55; transform: translate(-50%, -50%) scale(.9); }
      50% { opacity: 1; transform: translate(-50%, -50%) scale(1.15); }
    }

    .wall-lamp-glow {
      position: absolute;
      left: 9.6%;
      top: 12.6%;
      width: 9%;
      height: 7%;
      transform: translate(-50%, -50%);
      border-radius: 50%;
      background: radial-gradient(ellipse at center, rgba(255, 210, 130, .6) 0%, rgba(255, 180, 90, .3) 40%, rgba(255, 180, 90, 0) 70%);
      animation: lamp-glow-pulse 5s ease-in-out infinite;
      pointer-events: none;
      mix-blend-mode: screen;
    }

    @keyframes lamp-glow-pulse {
      0%, 100% { opacity: .7; transform: translate(-50%, -50%) scale(.95); }
      50% { opacity: 1; transform: translate(-50%, -50%) scale(1.08); }
    }

    .wall-toolbar {
      display: flex;
      align-items: center;
      align-self: flex-start;
      gap: .6rem;
    }

    .wall-mode-toggle {
      display: inline-flex;
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 3px;
      gap: 2px;
    }

    .wall-mode-toggle button {
      font-family: 'JetBrains Mono', monospace;
      font-size: .72rem;
      font-weight: 600;
      color: var(--muted);
      background: none;
      border: none;
      border-radius: 999px;
      padding: .35rem .8rem;
      cursor: pointer;
      transition: background .15s ease, color .15s ease;
    }

    .wall-mode-toggle button.active {
      color: #fff;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) .wall-mode-toggle button.active { color: #1a1a22; }
    }
    :root[data-theme="dark"] .wall-mode-toggle button.active { color: #1a1a22; }

    .wall-color-picker {
      position: relative;
    }

    .wall-color-pill {
      display: inline-flex;
      align-items: center;
      font-family: 'JetBrains Mono', monospace;
      font-size: .7rem;
      font-weight: 600;
      color: var(--text);
      background: var(--border);
      border: none;
      border-radius: 999px;
      padding: .28rem .7rem;
      cursor: pointer;
      transition: background .15s ease;
    }

    .wall-color-popover {
      display: none;
      position: absolute;
      top: calc(100% + .5rem);
      left: 0;
      align-items: center;
      gap: .4rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: .35rem;
      box-shadow: 0 8px 20px var(--shadow);
      z-index: 5;
    }

    .wall-color-popover.open { display: flex; }

    .wall-color-swatch {
      width: 1rem;
      height: 1rem;
      border-radius: 50%;
      border: none;
      padding: 0;
      cursor: pointer;
      box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .15);
      transition: transform .12s ease;
    }

    .wall-color-swatch:hover { transform: scale(1.15); }

    .wall-color-swatch.active {
      outline: 2px solid var(--text);
      outline-offset: 2px;
    }

    #wall-image-field { height: 3rem; }

    .wall-drop-zone {
      height: 100%;
      box-sizing: border-box;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px dashed var(--border);
      border-radius: 8px;
      padding: .4rem 1rem;
      text-align: center;
      cursor: pointer;
      transition: border-color .15s ease, background .15s ease;
    }

    .wall-drop-zone:hover, .wall-drop-zone:focus-visible, .wall-drop-zone.dragover {
      border-color: var(--accent);
      background: rgba(139, 92, 246, .05);
      outline: none;
    }

    .wall-drop-zone p {
      margin: 0;
      font-size: .76rem;
      color: var(--muted);
    }

    .wall-drop-zone strong { color: var(--text); }

    #wall-audio-field { display: flex; flex-direction: column; gap: .5rem; }

    .wall-audio-row {
      display: flex;
      align-items: center;
      gap: .75rem;
      height: 3rem;
    }

    .wall-audio-record {
      display: inline-flex;
      align-items: center;
      gap: .5rem;
      font-family: 'JetBrains Mono', monospace;
      font-size: .78rem;
      font-weight: 600;
      color: var(--text);
      background: var(--border);
      border: none;
      border-radius: 999px;
      padding: .55rem 1rem;
      cursor: pointer;
      transition: transform .12s ease, background .15s ease, color .15s ease;
    }

    .wall-audio-record:hover:not(.recording) { transform: translateY(-1px); }

    .wall-audio-record-dot {
      width: .5rem;
      height: .5rem;
      border-radius: 50%;
      background: #ef4444;
      flex-shrink: 0;
    }

    .wall-audio-record.recording {
      background: rgba(239, 68, 68, .12);
      color: #ef4444;
    }

    .wall-audio-record.recording .wall-audio-record-dot {
      animation: wall-audio-pulse 1.1s ease-in-out infinite;
    }

    @keyframes wall-audio-pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: .35; transform: scale(.75); }
    }

    .wall-audio-time {
      font-family: 'JetBrains Mono', monospace;
      font-size: .78rem;
      color: var(--muted);
      font-variant-numeric: tabular-nums;
    }

    .wall-audio-preview { width: 100%; height: 2.4rem; }

    .wall-text-row { position: relative; height: 3rem; }

    .wall-text-row input {
      width: 100%;
      height: 100%;
      box-sizing: border-box;
      font-family: 'JetBrains Mono', monospace;
      font-variant-ligatures: none;
      -webkit-font-feature-settings: "liga" 0, "calt" 0;
      font-feature-settings: "liga" 0, "calt" 0;
      font-size: .85rem;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0 3.4rem 0 .7rem;
    }

    .wall-text-row input:focus { outline: none; border-color: var(--accent); }

    .wall-counter {
      position: absolute;
      right: .7rem;
      top: 50%;
      transform: translateY(-50%);
      font-size: .64rem;
      color: var(--muted);
      font-variant-numeric: tabular-nums;
    }

    .wall-counter.warn { color: var(--accent-2); }

    .wall-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
      margin-top: .5rem;
    }

    .wall-send-group {
      display: flex;
      align-items: center;
      gap: .75rem;
    }

    .wall-learn-more {
      font-family: 'JetBrains Mono', monospace;
      font-size: .76rem;
      color: var(--muted);
      text-decoration: none;
      transition: color .15s ease;
    }

    .wall-learn-more:hover { color: var(--accent); }

    .wall-send {
      font-family: 'JetBrains Mono', monospace;
      font-size: .8rem;
      font-weight: 700;
      color: #fff;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      border: none;
      border-radius: 999px;
      padding: .55rem 1.3rem;
      cursor: pointer;
      transition: transform .12s ease, opacity .15s ease;
    }

    .wall-send:hover:not(:disabled) { transform: translateY(-1px); }
    .wall-send:disabled { opacity: .55; cursor: not-allowed; transform: none; }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) .wall-send { color: #1a1a22; }
    }
    :root[data-theme="dark"] .wall-send { color: #1a1a22; }

    .wall-toast {
      display: none;
      font-size: .74rem;
      color: var(--up);
      opacity: 0;
      transform: translateY(4px);
      transition: opacity .18s ease, transform .18s ease;
    }

    .wall-toast.show { display: inline-block; opacity: 1; transform: translateY(0); }
    .wall-toast.error { color: var(--down); }

    .wall-confetti-container {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      border-radius: 16px;
      z-index: 5;
    }

    .wall-confetti-piece {
      position: absolute;
      width: 6px;
      height: 6px;
      border-radius: 2px;
      animation: wall-confetti-burst 1.1s ease-out forwards;
    }

    @keyframes wall-confetti-burst {
      to {
        transform: translate(var(--dx), calc(var(--dy) - 110px)) rotate(var(--rot));
        opacity: 0;
      }
    }

    @media (max-width: 940px) {
      .wall-card { flex: none; }
      .wall-head { flex-direction: column; gap: .5rem; }
      .wall-actions { justify-content: center; }
    }
{% include "partials/responsive.css.j2" %}
  </style>
</head>

<body>
{% include "partials/header.html.j2" %}

  <main class="hero">
    <div class="hero-row">
      <div class="hero-copy">
        <h1 data-i18n="hero.title">{{ i18n['hero.title'] | safe }}</h1>
        <a class="repo-link" href="https://github.com/khaddict/voidnode" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-1.03-.01-1.87-2.78.62-3.37-1.21-3.37-1.21-.46-1.19-1.11-1.51-1.11-1.51-.91-.64.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.72 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.46.1 2.72.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.79-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.03 10.03 0 0 0 22 12.25C22 6.58 17.52 2 12 2z"/></svg>
          github.com/khaddict/voidnode
        </a>
      </div>

      <div class="wall-card">
        <div class="wall-head">
          <div class="wall-head-left">
            <span class="wall-eyebrow" data-i18n="wall.eyebrow">{{ i18n['wall.eyebrow'] }}</span>
            <span class="wall-messages-counter" id="wall-messages-counter" hidden></span>
          </div>
          <span class="wall-live-pill warn" id="wall-live-pill"><span class="dot warn" id="wall-live-dot"></span><span data-i18n="wall.checking" id="wall-live-text">{{ i18n['wall.checking'] }}</span></span>
        </div>
        <h2 data-i18n="wall.title">{{ i18n['wall.title'] }}</h2>

        <div class="wall-scene">
          <canvas id="wall-screen" width="288" height="64"></canvas>
          <span class="wall-port-led amber" style="left:17.45%;top:42.17%;animation-duration:2.2s;animation-delay:0s"></span>
          <span class="wall-port-led" style="left:17.85%;top:42.07%;animation-duration:2.6s;animation-delay:.9s"></span>
          <span class="wall-port-led" style="left:18.81%;top:41.86%;animation-duration:1.9s;animation-delay:.4s"></span>
          <span class="wall-port-led" style="left:19.75%;top:41.66%;animation-duration:2.4s;animation-delay:1.5s"></span>
          <span class="wall-port-led round" style="left:8.79%;top:55.00%;animation-duration:2.8s;animation-delay:.6s"></span>
          <span class="wall-port-led blue round" style="left:12.88%;top:43.63%;animation-duration:3.1s;animation-delay:1.2s"></span>
          <span class="wall-port-led blue round" style="left:18.36%;top:61.30%;animation-duration:2.5s;animation-delay:.3s"></span>
          <span class="wall-port-led amber round" style="left:17.08%;top:61.79%;animation-duration:3.3s;animation-delay:1.7s"></span>
          <span class="wall-crystal-aura"></span>
          <span class="wall-keyboard-glow"></span>
          <span class="wall-lamp-glow"></span>
        </div>

        <div class="wall-toolbar">
          <div class="wall-mode-toggle" role="tablist">
            <button type="button" class="active" role="tab" aria-selected="true" data-mode="text" data-i18n="wall.modeText">{{ i18n['wall.modeText'] }}</button>
            <button type="button" role="tab" aria-selected="false" data-mode="image" data-i18n="wall.modeImage">{{ i18n['wall.modeImage'] }}</button>
            <button type="button" role="tab" aria-selected="false" data-mode="audio" data-i18n="wall.modeAudio">{{ i18n['wall.modeAudio'] }}</button>
          </div>

          <div class="wall-color-picker" id="wall-color-picker">
            <button type="button" class="wall-color-pill" id="wall-color-trigger" aria-haspopup="true" aria-expanded="false">
              <span data-i18n="wall.color.pick">{{ i18n['wall.color.pick'] }}</span>
            </button>
            <div class="wall-color-popover" id="wall-color-popover">
{% for hex, key in [
  ('#FFFFFF', 'white'), ('#FF0000', 'red'), ('#FF8800', 'orange'), ('#FFFF00', 'yellow'),
  ('#00FF00', 'green'), ('#00FFFF', 'cyan'), ('#0066FF', 'blue'), ('#FF00FF', 'magenta'),
] %}
              <button type="button" class="wall-color-swatch{{ ' active' if loop.first }}" data-color="{{ hex }}" style="background:{{ hex }}" aria-label="{{ i18n['wall.color.' + key] }}" data-i18n-aria="wall.color.{{ key }}"></button>
{% endfor %}
            </div>
          </div>
        </div>

        <div class="wall-text-row" id="wall-text-field">
          <label class="sr-only" for="wall-message">{{ i18n['wall.messagePlaceholder'] }}</label>
          <input type="text" id="wall-message" maxlength="60" placeholder="{{ i18n['wall.messagePlaceholder'] }}">
          <span class="wall-counter" id="wall-counter">0/60</span>
        </div>

        <div id="wall-image-field" style="display:none;">
          <div class="wall-drop-zone" id="wall-drop-zone" tabindex="0">
            <p data-i18n="wall.dropZone">{{ i18n['wall.dropZone'] | safe }}</p>
          </div>
          <input type="file" id="wall-file-input" accept="image/png,image/jpeg,image/webp" style="display:none;">
        </div>

        <div id="wall-audio-field" style="display:none;">
          <div class="wall-audio-row">
            <button type="button" class="wall-audio-record" id="wall-audio-record" aria-pressed="false">
              <span class="wall-audio-record-dot"></span>
              <span id="wall-audio-record-label" data-i18n="wall.audio.record">{{ i18n['wall.audio.record'] }}</span>
            </button>
            <span class="wall-audio-time" id="wall-audio-time" hidden>0:00</span>
          </div>
          <audio class="wall-audio-preview" id="wall-audio-preview" controls hidden></audio>
        </div>

        <div class="wall-actions">
          <a class="wall-learn-more" href="{{ nav_blog_href }}{{ 'posts/busy-bar-message-wall/' if lang == 'fr' else '/posts/busy-bar-message-wall/' }}" data-i18n="wall.learnMore">{{ i18n['wall.learnMore'] }}</a>
          <div class="wall-send-group">
            <div class="wall-toast" id="wall-toast" role="status" aria-live="polite" data-i18n="wall.sent">{{ i18n['wall.sent'] }}</div>
            <button class="wall-send" id="wall-send" type="button" disabled data-i18n="wall.send">{{ i18n['wall.send'] }}</button>
          </div>
        </div>
      </div>
    </div>
  </main>

{% include "partials/footer.html.j2" %}

  <script>
    const I18N = {
{% for locale in ['en', 'fr'] %}
      {{ locale }}: {
{% for key, value in i18n_all[locale].items() %}
        '{{ key }}': {{ js_str(value) }},
{% endfor %}
      },
{% endfor %}
    };

    let currentLang = '{{ lang }}';

    function t(key) {
      return (I18N[currentLang] && I18N[currentLang][key]) || I18N.en[key] || key;
    }

{% set title_key = 'title.home' %}
{% include "partials/lang_theme_bootstrap.js.j2" %}

{% include "partials/copy_flash.js.j2" %}
{% include "partials/discord_copy.js.j2" %}

    (function () {
      const COLS = 72, ROWS = 16;
      const canvas = document.getElementById('wall-screen');
      const ctx = canvas.getContext('2d');
      const textarea = document.getElementById('wall-message');
      const counter = document.getElementById('wall-counter');
      const sendBtn = document.getElementById('wall-send');
      const toast = document.getElementById('wall-toast');

      let selectedColor = '#FFFFFF';

      function colorPillBackground(hex) {
        const r = parseInt(hex.slice(1, 3), 16);
        const g = parseInt(hex.slice(3, 5), 16);
        const b = parseInt(hex.slice(5, 7), 16);
        return `rgba(${r}, ${g}, ${b}, .3)`;
      }

      function updateCounter() {
        const len = textarea.value.length;
        counter.textContent = `${len}/60`;
        counter.classList.toggle('warn', len > 50);
      }

      textarea.addEventListener('input', () => { updateCounter(); updateSendAvailability(); });
      textarea.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter') return;
        e.preventDefault();
        if (!sendBtn.disabled) sendBtn.click();
      });

      let mode = 'text';
      let imageFile = null;
      let loadedImage = null;
      let audioBlob = null;
      const textField = document.getElementById('wall-text-field');
      const imageField = document.getElementById('wall-image-field');
      const audioField = document.getElementById('wall-audio-field');
      const dropZone = document.getElementById('wall-drop-zone');
      const fileInput = document.getElementById('wall-file-input');

      function imageToBuffer(img) {
        const tmp = document.createElement('canvas');
        tmp.width = COLS; tmp.height = ROWS;
        const tctx = tmp.getContext('2d');
        const scale = Math.min(COLS / img.width, ROWS / img.height);
        const dw = img.width * scale, dh = img.height * scale;
        tctx.drawImage(img, (COLS - dw) / 2, (ROWS - dh) / 2, dw, dh);
        return tctx.getImageData(0, 0, COLS, ROWS).data; // RGBA, the bar's screen is color
      }

      function drawImageBuffer(data) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        const cell = canvas.width / COLS;
        for (let y = 0; y < ROWS; y++) {
          for (let x = 0; x < COLS; x++) {
            const i = (y * COLS + x) * 4;
            const a = data[i + 3] / 255;
            if (a < 0.05) continue;
            ctx.globalAlpha = a;
            ctx.fillStyle = `rgb(${data[i]}, ${data[i + 1]}, ${data[i + 2]})`;
            ctx.beginPath();
            ctx.arc(x * cell + cell / 2, y * cell + cell / 2, Math.max(0.75, cell * 0.32), 0, Math.PI * 2);
            ctx.fill();
          }
        }
        ctx.globalAlpha = 1;
      }

      const colorPicker = document.getElementById('wall-color-picker');
      const colorTrigger = document.getElementById('wall-color-trigger');
      const colorPopover = document.getElementById('wall-color-popover');

      document.querySelectorAll('.wall-mode-toggle button').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (btn.dataset.mode !== 'audio' && audioRecordBtn.classList.contains('recording')) stopAudioRecording();
          document.querySelectorAll('.wall-mode-toggle button').forEach((b) => {
            b.classList.remove('active');
            b.setAttribute('aria-selected', 'false');
          });
          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');
          mode = btn.dataset.mode;
          textField.style.display = mode === 'text' ? '' : 'none';
          imageField.style.display = mode === 'image' ? '' : 'none';
          audioField.style.display = mode === 'audio' ? '' : 'none';
          colorPicker.style.display = mode === 'text' ? '' : 'none';
          updateSendAvailability();
          if (isComposing()) {
            stopMirror();
            drawImageBuffer(imageToBuffer(loadedImage));
          } else {
            drawImageBuffer(new Uint8ClampedArray(COLS * ROWS * 4));
            startMirror();
          }
        });
      });

      colorTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = colorPopover.classList.toggle('open');
        colorTrigger.setAttribute('aria-expanded', String(isOpen));
      });

      document.querySelectorAll('.wall-color-swatch').forEach((sw) => {
        sw.addEventListener('click', () => {
          document.querySelectorAll('.wall-color-swatch').forEach((s) => s.classList.remove('active'));
          sw.classList.add('active');
          selectedColor = sw.dataset.color;
          colorTrigger.style.background = colorPillBackground(selectedColor);
          colorPopover.classList.remove('open');
          colorTrigger.setAttribute('aria-expanded', 'false');
        });
      });

      document.addEventListener('click', (e) => {
        if (colorPopover.classList.contains('open') && !colorPopover.contains(e.target) && e.target !== colorTrigger) {
          colorPopover.classList.remove('open');
          colorTrigger.setAttribute('aria-expanded', 'false');
        }
      });

      let imgErrorTimer = null;

      function loadImageFile(file) {
        if (!file || !file.type.startsWith('image/')) return;
        imageFile = file;
        loadedImage = null;
        const img = new Image();
        img.onload = () => {
          loadedImage = img;
          stopMirror();
          drawImageBuffer(imageToBuffer(img));
          updateSendAvailability();
        };
        img.onerror = () => {
          imageFile = null;
          loadedImage = null;
          updateSendAvailability();
          toast.classList.add('error');
          toast.textContent = t('wall.error');
          toast.classList.add('show');
          clearTimeout(imgErrorTimer);
          imgErrorTimer = setTimeout(() => toast.classList.remove('show', 'error'), 3000);
        };
        img.src = URL.createObjectURL(file);
      }

      dropZone.addEventListener('click', () => fileInput.click());
      dropZone.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          fileInput.click();
        }
      });
      fileInput.addEventListener('change', () => loadImageFile(fileInput.files[0]));

      ['dragenter', 'dragover'].forEach((evt) => {
        dropZone.addEventListener(evt, (e) => {
          e.preventDefault();
          dropZone.classList.add('dragover');
        });
      });
      ['dragleave', 'dragend'].forEach((evt) => {
        dropZone.addEventListener(evt, () => dropZone.classList.remove('dragover'));
      });
      dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('dragover');
        loadImageFile(e.dataTransfer.files[0]);
      });

      const AUDIO_MAX_SECONDS = 20;
      const audioRecordBtn = document.getElementById('wall-audio-record');
      const audioRecordLabel = document.getElementById('wall-audio-record-label');
      const audioTimeEl = document.getElementById('wall-audio-time');
      const audioPreview = document.getElementById('wall-audio-preview');
      let mediaRecorder = null;
      let audioChunks = [];
      let audioTimerInterval = null;
      let audioSecondsElapsed = 0;

      function formatAudioTime(totalSeconds) {
        const m = Math.floor(totalSeconds / 60);
        const s = totalSeconds % 60;
        return `${m}:${String(s).padStart(2, '0')}`;
      }

      function stopAudioRecording() {
        clearInterval(audioTimerInterval);
        audioTimerInterval = null;
        if (mediaRecorder && mediaRecorder.state !== 'inactive') mediaRecorder.stop();
        audioRecordBtn.classList.remove('recording');
        audioRecordBtn.setAttribute('aria-pressed', 'false');
        audioRecordLabel.textContent = t('wall.audio.record');
      }

      function stopAudioRecordingAndWait() {
        if (!mediaRecorder || mediaRecorder.state === 'inactive') return Promise.resolve();
        const done = new Promise((resolve) => mediaRecorder.addEventListener('stop', resolve, { once: true }));
        stopAudioRecording();
        return done;
      }

      async function startAudioRecording() {
        let stream;
        try {
          stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        } catch {
          toast.textContent = t('wall.audio.micDenied');
          toast.classList.add('error', 'show');
          clearTimeout(imgErrorTimer);
          imgErrorTimer = setTimeout(() => toast.classList.remove('show', 'error'), 3000);
          return;
        }

        audioChunks = [];
        mediaRecorder = new MediaRecorder(stream);
        mediaRecorder.addEventListener('dataavailable', (e) => {
          if (e.data.size > 0) audioChunks.push(e.data);
        });
        mediaRecorder.addEventListener('stop', () => {
          stream.getTracks().forEach((track) => track.stop());
          audioBlob = new Blob(audioChunks, { type: mediaRecorder.mimeType || 'audio/webm' });
          audioPreview.src = URL.createObjectURL(audioBlob);
          audioPreview.hidden = false;
          updateSendAvailability();
        });
        mediaRecorder.start();

        audioBlob = null;
        updateSendAvailability();
        audioPreview.hidden = true;
        audioSecondsElapsed = 0;
        audioTimeEl.hidden = false;
        audioTimeEl.textContent = formatAudioTime(0);
        audioRecordBtn.classList.add('recording');
        audioRecordBtn.setAttribute('aria-pressed', 'true');
        audioRecordLabel.textContent = t('wall.audio.stop');

        audioTimerInterval = setInterval(() => {
          audioSecondsElapsed += 1;
          audioTimeEl.textContent = formatAudioTime(audioSecondsElapsed);
          if (audioSecondsElapsed >= AUDIO_MAX_SECONDS) stopAudioRecording();
        }, 1000);
      }

      audioRecordBtn.addEventListener('click', () => {
        if (audioRecordBtn.classList.contains('recording')) {
          stopAudioRecording();
        } else {
          startAudioRecording();
        }
      });

      const API_URL = '{{ api_base_url }}';

      let mirrorInterval = null;
      let hasMirrorFrame = false;
      const mirrorImg = new Image();
      mirrorImg.crossOrigin = 'anonymous';

      function isComposing() {
        return mode === 'image' && !!loadedImage;
      }

      function pollMirror() {
        mirrorImg.onload = () => {
          if (!mirrorInterval) return;
          hasMirrorFrame = true;
          drawImageBuffer(imageToBuffer(mirrorImg));
        };
        mirrorImg.src = `${API_URL}/wall/screen?t=${Date.now()}`;
      }

      function startMirror() {
        if (mirrorInterval) return;
        pollMirror();
        mirrorInterval = setInterval(pollMirror, 1500);
      }

      function stopMirror() {
        clearInterval(mirrorInterval);
        mirrorInterval = null;
      }

      const livePill = document.getElementById('wall-live-pill');
      const liveDot = document.getElementById('wall-live-dot');
      const liveText = document.getElementById('wall-live-text');
      const wallMessagesCounter = document.getElementById('wall-messages-counter');

      function setMessagesToday(count) {
        if (!Number.isFinite(count)) return;
        wallMessagesCounter.textContent = `${count} ${t(count === 1 ? 'wall.messageToday' : 'wall.messagesToday')}`;
        wallMessagesCounter.hidden = false;
      }

      let barOnline = false;

      function hasContent() {
        if (mode === 'text') return textarea.value.trim().length > 0;
        if (mode === 'image') return !!loadedImage;
        return !!audioBlob;
      }

      function updateSendAvailability() {
        sendBtn.disabled = cooling || !barOnline || !hasContent();
      }

      function setBarOnline(online) {
        barOnline = online;
        livePill.classList.remove('warn');
        livePill.classList.toggle('down', !online);
        liveDot.classList.remove('warn');
        liveDot.classList.toggle('up', online);
        liveDot.classList.toggle('down', !online);
        liveText.textContent = t(online ? 'wall.live' : 'wall.offline');
        updateSendAvailability();
      }

      async function refreshBarStatus() {
        try {
          const res = await fetch(`${API_URL}/busybar/status`);
          const data = await res.json();
          setBarOnline(!!data.online);
          setMessagesToday(data.messages_today);
          if (!cooling && Number.isFinite(data.rate_limit_remaining) && data.rate_limit_remaining > 0) {
            persistCooldown(data.rate_limit_remaining);
            startCooldown(data.rate_limit_remaining);
          }
        } catch {
          setBarOnline(false);
        }
      }

      function reportResult(res) {
        if (res.ok) {
          toast.textContent = t('wall.sent');
          return 30;
        }
        toast.textContent = res.status === 429 ? t('wall.rateLimited') : t('wall.error');
        toast.classList.add('error');
        if (res.status === 429) {
          const retryAfter = parseInt(res.headers.get('Retry-After'), 10);
          if (Number.isFinite(retryAfter) && retryAfter > 0) return retryAfter;
        }
        return 30;
      }

      const sendLabel = sendBtn.textContent;
      const COOLDOWN_KEY = 'wallCooldownUntil';

      function persistCooldown(waitSecs) {
        try { localStorage.setItem(COOLDOWN_KEY, String(Date.now() + waitSecs * 1000)); } catch {}
      }

      function startCooldown(initialSecs) {
        let secs = initialSecs || 30;
        cooling = true;
        sendBtn.disabled = true;
        sendBtn.textContent = `${secs}s`;
        const iv = setInterval(() => {
          secs -= 1;
          if (secs <= 0) {
            clearInterval(iv);
            cooling = false;
            updateSendAvailability();
            sendBtn.textContent = sendLabel;
            toast.classList.remove('show');
            try { localStorage.removeItem(COOLDOWN_KEY); } catch {}
          } else {
            sendBtn.textContent = `${secs}s`;
          }
        }, 1000);
      }

      let cooling = false;

      function spawnWallConfetti(anchor, color) {
        const card = anchor.closest('.wall-card');
        const cardRect = card.getBoundingClientRect();
        const anchorRect = anchor.getBoundingClientRect();
        const originX = anchorRect.left + anchorRect.width / 2 - cardRect.left;
        const originY = anchorRect.top + anchorRect.height / 2 - cardRect.top;

        const container = document.createElement('div');
        container.className = 'wall-confetti-container';
        card.appendChild(container);

        for (let i = 0; i < 32; i++) {
          const piece = document.createElement('span');
          piece.className = 'wall-confetti-piece';
          const angle = Math.random() * Math.PI * 2;
          const distance = 40 + Math.random() * 90;
          piece.style.left = originX + 'px';
          piece.style.top = originY + 'px';
          piece.style.background = color;
          piece.style.setProperty('--dx', (Math.cos(angle) * distance) + 'px');
          piece.style.setProperty('--dy', (Math.sin(angle) * distance - 20) + 'px');
          piece.style.setProperty('--rot', (Math.random() * 720 - 360) + 'deg');
          piece.style.animationDelay = (Math.random() * .2) + 's';
          container.appendChild(piece);
        }

        setTimeout(() => container.remove(), 1400);
      }

      (function restoreCooldown() {
        let until = 0;
        try { until = parseInt(localStorage.getItem(COOLDOWN_KEY), 10) || 0; } catch {}
        const remaining = Math.ceil((until - Date.now()) / 1000);
        if (remaining > 0) startCooldown(remaining);
      })();
      async function sendWallPayload(doFetch, onSuccess) {
        cooling = true;
        sendBtn.disabled = true;
        toast.classList.remove('error');
        toast.textContent = t('wall.sending');
        toast.classList.add('show');
        let waitSecs = 30;
        try {
          const res = await doFetch();
          waitSecs = reportResult(res);
          if (res.ok) {
            refreshBarStatus();
            onSuccess();
          }
        } catch {
          toast.textContent = t('wall.error');
          toast.classList.add('error');
        }
        persistCooldown(waitSecs);
        startCooldown(waitSecs);
      }

      sendBtn.addEventListener('click', async () => {
        if (cooling || !barOnline) return;
        if (mode === 'text') {
          const message = textarea.value.trim();
          if (!message) return;
          await sendWallPayload(
            () => fetch(`${API_URL}/wall/message`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ message, color: selectedColor }),
            }),
            () => {
              spawnWallConfetti(sendBtn, selectedColor);
              textarea.value = '';
              updateCounter();
              updateSendAvailability();
            },
          );
        } else if (mode === 'image') {
          if (!loadedImage) return;
          await sendWallPayload(
            () => {
              const form = new FormData();
              form.append('file', imageFile);
              return fetch(`${API_URL}/wall/image`, { method: 'POST', body: form });
            },
            () => {
              loadedImage = null;
              imageFile = null;
              fileInput.value = '';
              updateSendAvailability();
              startMirror();
            },
          );
        } else {
          if (audioRecordBtn.classList.contains('recording')) await stopAudioRecordingAndWait();
          if (!audioBlob) return;
          await sendWallPayload(
            () => {
              const form = new FormData();
              form.append('file', audioBlob, 'recording');
              return fetch(`${API_URL}/wall/audio`, { method: 'POST', body: form });
            },
            () => {
              audioBlob = null;
              updateSendAvailability();
              audioPreview.hidden = true;
              audioPreview.removeAttribute('src');
              audioTimeEl.hidden = true;
              audioSecondsElapsed = 0;
            },
          );
        }
      });

      function resizeCanvasForDisplay() {
        const rect = canvas.getBoundingClientRect();
        if (!rect.width || !rect.height) return;
        const dpr = window.devicePixelRatio || 1;
        const cell = Math.max(1, Math.round((rect.width * dpr) / COLS));
        const newWidth = cell * COLS;
        const newHeight = cell * ROWS;
        if (canvas.width === newWidth && canvas.height === newHeight) return;
        canvas.width = newWidth;
        canvas.height = newHeight;
        if (mode === 'image' && loadedImage) {
          drawImageBuffer(imageToBuffer(loadedImage));
        } else if (hasMirrorFrame) {
          drawImageBuffer(imageToBuffer(mirrorImg));
        }
      }
      new ResizeObserver(resizeCanvasForDisplay).observe(canvas);

      updateCounter();
      resizeCanvasForDisplay();
      startMirror();
      let statusInterval = null;

      function startStatusPolling() {
        refreshBarStatus();
        if (!statusInterval) statusInterval = setInterval(refreshBarStatus, 30000);
      }

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          clearInterval(statusInterval);
          statusInterval = null;
          stopMirror();
          if (audioRecordBtn.classList.contains('recording')) stopAudioRecording();
        } else {
          startStatusPolling();
          if (!isComposing()) startMirror();
        }
      });

      startStatusPolling();
    })();
  </script>

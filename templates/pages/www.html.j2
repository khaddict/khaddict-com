{% from "partials/js_str.j2" import js_str %}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script>
{% include "partials/theme_toggle.js.j2" %}
  </script>
  <title>{{ i18n['title.home'] }}</title>
  <meta name="description" content="{{ meta_description }}" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="{{ og_url }}" />
  <meta property="og:title" content="khaddict" />
  <meta property="og:description" content="{{ meta_description }}" />
  <meta property="og:image" content="{{ brand_icon_src }}" />
  <meta property="og:locale" content="{{ og_locale }}" />
  <meta property="og:locale:alternate" content="{{ og_locale_alternate }}" />
  <link rel="canonical" href="{{ canonical_url }}" />
  <link rel="alternate" hreflang="en" href="{{ hreflang_en_href }}" />
  <link rel="alternate" hreflang="fr" href="{{ hreflang_fr_href }}" />
  <link rel="alternate" hreflang="x-default" href="{{ hreflang_x_default_href }}" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="khaddict" />
  <meta name="twitter:image" content="{{ brand_icon_src }}" />
  <link rel="icon" href="{{ brand_icon_src }}" type="image/png" />
  <link rel="apple-touch-icon" href="{{ brand_icon_src }}" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700;800&display=swap" rel="stylesheet" />

  <!-- Matomo -->
  <script>
    var _paq = window._paq = window._paq || [];
    _paq.push(['trackPageView']);
    _paq.push(['enableLinkTracking']);
    (function() {
      var u="//matomo.khaddict.com/";
      _paq.push(['setTrackerUrl', u+'matomo.php']);
      _paq.push(['setSiteId', '1']);
      var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
      g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
    })();
  </script>
  <!-- End Matomo -->

  <style>
{% include "partials/head_tokens.css.j2" %}
{% include "partials/status_widget.css.j2" %}
    /* hero */
    .hero {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 3rem 1.5rem;
      animation: fade-up .45s ease both;
    }

    .hero-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 3rem;
      max-width: 1400px;
      width: 100%;
    }

    .hero-copy { flex: 0 1 500px; text-align: left; }

    .hero h1 {
      font-size: clamp(1.5rem, 4vw, 2.1rem);
      font-weight: 700;
      line-height: 1.4;
      max-width: 500px;
      letter-spacing: -.02em;
    }

    @media (max-width: 940px) {
      .hero-row { flex-direction: column; text-align: center; gap: 2rem; }
      .hero-copy { flex: none; text-align: center; max-width: 100%; }
      .hero h1 { max-width: 100%; margin: 0 auto; }
    }

    .hero .highlight {
      background: linear-gradient(90deg, var(--accent), var(--accent-2));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .repo-link {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      margin-top: .9rem;
      font-family: 'JetBrains Mono', monospace;
      font-size: .8rem;
      color: var(--muted);
      text-decoration: none;
      transition: color .15s ease;
    }
    .repo-link:hover { color: var(--accent); }
    .repo-link svg { width: 14px; height: 14px; }

    @keyframes fade-up {
      from { opacity: 0; transform: translateY(10px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* busy bar wall */
    .wall-card {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: .75rem;
      padding: 1.4rem 1.75rem;
      border-radius: 16px;
      background: var(--surface);
      border: 1px solid var(--border);
      box-shadow: 0 20px 50px var(--shadow);
      flex: 1 1 620px;
      max-width: 720px;
      width: 100%;
      transition: background-color .2s ease, border-color .2s ease;
    }

    .wall-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .wall-eyebrow {
      font-size: .68rem;
      font-weight: 600;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--accent);
    }

    .wall-live-pill {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      font-size: .7rem;
      font-weight: 600;
      color: var(--text);
      background: var(--up-bg);
      padding: .28rem .6rem .28rem .5rem;
      border-radius: 999px;
      flex-shrink: 0;
      white-space: nowrap;
    }

    .wall-card h2 {
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: -.01em;
      margin: -.4rem 0 0;
    }

    .wall-sub {
      font-size: .8rem;
      color: var(--muted);
      line-height: 1.6;
      margin: 0;
    }

    .screen-shell {
      background: #050507;
      border-radius: 8px;
      padding: .85rem;
      box-shadow: inset 0 2px 12px rgba(0, 0, 0, .55);
    }

    .screen-shell canvas {
      display: block;
      width: 100%;
      height: auto;
      image-rendering: pixelated;
    }

    .wall-toolbar {
      display: flex;
      align-items: center;
      align-self: flex-start;
      gap: .6rem;
    }

    .wall-mode-toggle {
      display: inline-flex;
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 3px;
      gap: 2px;
    }

    .wall-mode-toggle button {
      font-family: 'JetBrains Mono', monospace;
      font-size: .72rem;
      font-weight: 600;
      color: var(--muted);
      background: none;
      border: none;
      border-radius: 999px;
      padding: .35rem .8rem;
      cursor: pointer;
      transition: background .15s ease, color .15s ease;
    }

    .wall-mode-toggle button.active {
      color: #fff;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
    }

    .wall-color-picker {
      position: relative;
    }

    .wall-color-pill {
      display: inline-flex;
      align-items: center;
      font-family: 'JetBrains Mono', monospace;
      font-size: .7rem;
      font-weight: 600;
      color: var(--text);
      background: var(--border);
      border: none;
      border-radius: 999px;
      padding: .28rem .7rem;
      cursor: pointer;
      transition: background .15s ease;
    }

    .wall-color-popover {
      display: none;
      position: absolute;
      top: calc(100% + .5rem);
      left: 0;
      align-items: center;
      gap: .4rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: .35rem;
      box-shadow: 0 8px 20px var(--shadow);
      z-index: 5;
    }

    .wall-color-popover.open { display: flex; }

    .wall-color-swatch {
      width: 1rem;
      height: 1rem;
      border-radius: 50%;
      border: none;
      padding: 0;
      cursor: pointer;
      box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .15);
      transition: transform .12s ease;
    }

    .wall-color-swatch:hover { transform: scale(1.15); }

    .wall-color-swatch.active {
      outline: 2px solid var(--text);
      outline-offset: 2px;
    }

    #wall-image-field { height: 3rem; }

    .wall-drop-zone {
      height: 100%;
      box-sizing: border-box;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px dashed var(--border);
      border-radius: 8px;
      padding: .4rem 1rem;
      text-align: center;
      cursor: pointer;
      transition: border-color .15s ease, background .15s ease;
    }

    .wall-drop-zone:hover, .wall-drop-zone:focus-visible {
      border-color: var(--accent);
      background: rgba(139, 92, 246, .05);
      outline: none;
    }

    .wall-drop-zone p {
      margin: 0;
      font-size: .76rem;
      color: var(--muted);
    }

    .wall-drop-zone strong { color: var(--text); }

    .wall-text-row { position: relative; height: 3rem; }

    .wall-text-row input {
      width: 100%;
      height: 100%;
      box-sizing: border-box;
      font-family: 'JetBrains Mono', monospace;
      font-variant-ligatures: none;
      -webkit-font-feature-settings: "liga" 0, "calt" 0;
      font-feature-settings: "liga" 0, "calt" 0;
      font-size: .85rem;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0 3.4rem 0 .7rem;
    }

    .wall-text-row input:focus { outline: none; border-color: var(--accent); }

    .wall-counter {
      position: absolute;
      right: .7rem;
      top: 50%;
      transform: translateY(-50%);
      font-size: .64rem;
      color: var(--muted);
      font-variant-numeric: tabular-nums;
    }

    .wall-counter.warn { color: var(--accent-2); }

    .wall-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .wall-learn-more {
      font-family: 'JetBrains Mono', monospace;
      font-size: .76rem;
      color: var(--muted);
      text-decoration: none;
      transition: color .15s ease;
    }

    .wall-learn-more:hover { color: var(--accent); }

    .wall-send {
      font-family: 'JetBrains Mono', monospace;
      font-size: .8rem;
      font-weight: 700;
      color: #fff;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      border: none;
      border-radius: 999px;
      padding: .55rem 1.3rem;
      cursor: pointer;
      transition: transform .12s ease, opacity .15s ease;
    }

    .wall-send:hover:not(:disabled) { transform: translateY(-1px); }
    .wall-send:disabled { opacity: .55; cursor: not-allowed; transform: none; }

    .wall-toast {
      position: absolute;
      left: 1.75rem;
      right: 1.75rem;
      bottom: .5rem;
      font-size: .74rem;
      color: var(--up);
      opacity: 0;
      transform: translateY(4px);
      transition: opacity .18s ease, transform .18s ease;
      pointer-events: none;
    }

    .wall-toast.show { opacity: 1; transform: translateY(0); }
    .wall-toast.error { color: var(--down); }

    @media (max-width: 940px) {
      .wall-card { flex: none; }
      .wall-head { flex-direction: column; gap: .5rem; }
      .wall-actions { justify-content: center; }
    }
{% include "partials/responsive.css.j2" %}
  </style>
</head>

<body>
{% include "partials/header.html.j2" %}

  <main class="hero">
    <div class="hero-row">
      <div class="hero-copy">
        <h1 data-i18n="hero.title">{{ i18n['hero.title'] | safe }}</h1>
        <a class="repo-link" href="https://github.com/khaddict/voidnode" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-1.03-.01-1.87-2.78.62-3.37-1.21-3.37-1.21-.46-1.19-1.11-1.51-1.11-1.51-.91-.64.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.72 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.46.1 2.72.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.79-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.03 10.03 0 0 0 22 12.25C22 6.58 17.52 2 12 2z"/></svg>
          github.com/khaddict/voidnode
        </a>
      </div>

      <div class="wall-card">
        <div class="wall-head">
          <span class="wall-eyebrow" data-i18n="wall.eyebrow">{{ i18n['wall.eyebrow'] }}</span>
          <span class="wall-live-pill"><span class="dot up"></span><span data-i18n="wall.live">{{ i18n['wall.live'] }}</span></span>
        </div>
        <h2 data-i18n="wall.title">{{ i18n['wall.title'] }}</h2>
        <p class="wall-sub" data-i18n="wall.sub">{{ i18n['wall.sub'] }}</p>

        <div class="screen-shell">
          <canvas id="wall-screen" width="288" height="64"></canvas>
        </div>

        <div class="wall-toolbar">
          <div class="wall-mode-toggle" role="tablist">
            <button type="button" class="active" data-mode="text" data-i18n="wall.modeText">{{ i18n['wall.modeText'] }}</button>
            <button type="button" data-mode="image" data-i18n="wall.modeImage">{{ i18n['wall.modeImage'] }}</button>
          </div>

          <div class="wall-color-picker" id="wall-color-picker">
            <button type="button" class="wall-color-pill" id="wall-color-trigger" aria-haspopup="true" aria-expanded="false">
              <span data-i18n="wall.color.pick">{{ i18n['wall.color.pick'] }}</span>
            </button>
            <div class="wall-color-popover" id="wall-color-popover" role="menu">
              <button type="button" class="wall-color-swatch active" data-color="#FFFFFF" style="background:#FFFFFF" data-i18n-aria="wall.color.white"></button>
              <button type="button" class="wall-color-swatch" data-color="#FF0000" style="background:#FF0000" data-i18n-aria="wall.color.red"></button>
              <button type="button" class="wall-color-swatch" data-color="#FF8800" style="background:#FF8800" data-i18n-aria="wall.color.orange"></button>
              <button type="button" class="wall-color-swatch" data-color="#FFFF00" style="background:#FFFF00" data-i18n-aria="wall.color.yellow"></button>
              <button type="button" class="wall-color-swatch" data-color="#00FF00" style="background:#00FF00" data-i18n-aria="wall.color.green"></button>
              <button type="button" class="wall-color-swatch" data-color="#00FFFF" style="background:#00FFFF" data-i18n-aria="wall.color.cyan"></button>
              <button type="button" class="wall-color-swatch" data-color="#0066FF" style="background:#0066FF" data-i18n-aria="wall.color.blue"></button>
              <button type="button" class="wall-color-swatch" data-color="#FF00FF" style="background:#FF00FF" data-i18n-aria="wall.color.magenta"></button>
            </div>
          </div>
        </div>

        <div class="wall-text-row" id="wall-text-field">
          <input type="text" id="wall-message" maxlength="60">
          <span class="wall-counter" id="wall-counter">0/60</span>
        </div>

        <div id="wall-image-field" style="display:none;">
          <div class="wall-drop-zone" id="wall-drop-zone" tabindex="0">
            <p data-i18n="wall.dropZone">{{ i18n['wall.dropZone'] | safe }}</p>
          </div>
          <input type="file" id="wall-file-input" accept="image/png,image/jpeg,image/webp" style="display:none;">
        </div>

        <div class="wall-actions">
          <a class="wall-learn-more" href="{{ nav_blog_href }}{{ 'posts/busy-bar-message-wall/' if lang == 'fr' else '/posts/busy-bar-message-wall/' }}" data-i18n="wall.learnMore">{{ i18n['wall.learnMore'] }}</a>
          <button class="wall-send" id="wall-send" type="button" data-i18n="wall.send">{{ i18n['wall.send'] }}</button>
        </div>

        <div class="wall-toast" id="wall-toast" data-i18n="wall.sent">{{ i18n['wall.sent'] }}</div>
      </div>
    </div>
  </main>

{% include "partials/footer.html.j2" %}

  <script>
    const I18N = {
{% for locale in ['en', 'fr'] %}
      {{ locale }}: {
{% for key, value in i18n_all[locale].items() %}
        '{{ key }}': {{ js_str(value) }},
{% endfor %}
      },
{% endfor %}
    };

    let currentLang = '{{ lang }}';

    function t(key) {
      return (I18N[currentLang] && I18N[currentLang][key]) || I18N.en[key] || key;
    }

    function applyLanguage() {
      document.documentElement.lang = currentLang;
      document.title = t('title.home');
      document.querySelectorAll('[data-i18n]').forEach((el) => {
        el.innerHTML = t(el.getAttribute('data-i18n'));
      });
      document.querySelectorAll('[data-i18n-aria]').forEach((el) => {
        el.setAttribute('aria-label', t(el.getAttribute('data-i18n-aria')));
      });
      document.getElementById('lang-current').textContent = currentLang.toUpperCase();
      document.querySelectorAll('.lang-option').forEach((el) => {
        el.classList.toggle('active', el.getAttribute('data-lang') === currentLang);
      });
    }

    applyLanguage();

    const langBtn = document.getElementById('lang-btn');
    const langDropdown = document.getElementById('lang-dropdown');

    langBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = langDropdown.classList.toggle('open');
      langBtn.setAttribute('aria-expanded', isOpen);
    });
    document.addEventListener('click', (e) => {
      if (!langDropdown.contains(e.target) && e.target !== langBtn) {
        langDropdown.classList.remove('open');
        langBtn.setAttribute('aria-expanded', 'false');
      }
    });
{% include "partials/status_widget.js.j2" %}

    document.getElementById('theme-toggle').addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      setThemeCookie(next);
    });

    (function () {
      const discordBtn = document.getElementById('discord-btn');
      const discordToast = document.getElementById('discord-toast');
      let toastTimer = null;

      discordBtn.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText('khaddict'); } catch { /* clipboard unavailable */ }
        discordBtn.classList.add('copied');
        discordToast.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          discordToast.classList.remove('show');
          discordBtn.classList.remove('copied');
        }, 900);
      });
    })();

    (function () {
      const COLS = 72, ROWS = 16;
      const canvas = document.getElementById('wall-screen');
      const ctx = canvas.getContext('2d');
      const textarea = document.getElementById('wall-message');
      const counter = document.getElementById('wall-counter');
      const sendBtn = document.getElementById('wall-send');
      const toast = document.getElementById('wall-toast');

      // hand-transcribed bitmap font, matches the real BUSY app pixel grid
